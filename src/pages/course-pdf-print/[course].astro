---
import { getCollection, render, type CollectionEntry } from "astro:content";
import CoursePdfKnowledgeCheck from "../../components/CoursePdfKnowledgeCheck.astro";
import CoursePdfPracticeTask from "../../components/CoursePdfPracticeTask.astro";
import CoursePdfReflection from "../../components/CoursePdfReflection.astro";
import CoursePdfTaskRubric from "../../components/CoursePdfTaskRubric.astro";
import CoursePdfTaskSolution from "../../components/CoursePdfTaskSolution.astro";
import ContentFreshness from "../../components/ContentFreshness.astro";
import { semanticComponents } from "../../components/semantic-components";
import WorkloadSummary from "../../components/WorkloadSummary.astro";
import CoursePdfLayout from "../../layouts/CoursePdfLayout.astro";
import { coursePdfFilename } from "../../lib/course-pdf";
import {
  capstonePath,
  checkpointPath,
  courseMinutes,
  courseFreshnessState,
  coursePath,
  formatLessonCount,
  formatMinutes,
  formatModuleCount,
  getCourseTree,
  lessonPath,
  lessonSlug,
  modulePath,
  moduleSlug,
  type CourseTree,
} from "../../lib/courses";

export async function getStaticPaths() {
  const courses = await getCollection("courses");
  return Promise.all(
    courses.map(async (course) => ({
      params: { course: course.id },
      props: { course, tree: await getCourseTree(course.id) },
    })),
  );
}

type Props = {
  course: CollectionEntry<"courses">;
  tree: CourseTree;
};

const { course, tree } = Astro.props as Props;
const coursePdfSemanticComponents = {
  ...semanticComponents,
  KnowledgeCheck: CoursePdfKnowledgeCheck,
  PracticeTask: CoursePdfPracticeTask,
  Reflection: CoursePdfReflection,
  TaskRubric: CoursePdfTaskRubric,
  TaskSolution: CoursePdfTaskSolution,
};
const { Content: CourseContent } = await render(course);
const modules = await Promise.all(
  tree.modules.map(async ({ module, lessons, checkpoint }) => ({
    module,
    ModuleContent: (await render(module)).Content,
    lessons: await Promise.all(
      lessons.map(async (lesson) => ({
        lesson,
        LessonContent: (await render(lesson)).Content,
      })),
    ),
    checkpoint,
    CheckpointContent: (await render(checkpoint)).Content,
  })),
);
const { Content: CapstoneContent } = await render(tree.capstone);
const canonicalUrl = new URL(coursePath(course.id), Astro.site).href;
const freshness = courseFreshnessState(course, tree);
const lessons = tree.modules.flatMap((courseModule) => courseModule.lessons);
---

<CoursePdfLayout
  filename={coursePdfFilename(course.id)}
  title={`${course.data.title} | Prosto.Courses`}
>
  <main class="course-pdf type-reading reading-flow">
    <header class="course-pdf__cover" data-course-pdf-required-section>
      <p class="course-pdf__section-label type-meta">Курс</p>
      <h1 class="type-page-title">{course.data.title}</h1>
      <p class="course-pdf__summary">{course.data.summary}</p>
      <div class="course-pdf__release-identity">
        <ContentFreshness state={freshness} />
        <dl>
          <div>
            <dt>Дата сборки PDF</dt>
            <dd><time data-course-pdf-build-date></time></dd>
          </div>
          <div>
            <dt>Канонический адрес курса</dt>
            <dd><a href={canonicalUrl}>{canonicalUrl}</a></dd>
          </div>
        </dl>
      </div>
    </header>

    <nav
      class="course-pdf__toc"
      aria-labelledby="course-pdf-toc-title"
      data-course-pdf-required-section
    >
      <h2 id="course-pdf-toc-title" class="type-page-title">Содержание</h2>
      <ol>
        <li><a href="#course-overview">О курсе</a></li>
        <li>
          <span>Модули и уроки</span>
          <ol>
            {modules.map(({ module, lessons }, moduleIndex) => {
              const currentModuleSlug = moduleSlug(module);
              return (
                <li>
                  <a href={`#module-${currentModuleSlug}`}>
                    Модуль {moduleIndex + 1}. {module.data.title}
                  </a>
                  <ol>
                    {lessons.map(({ lesson }, lessonIndex) => (
                      <li>
                        <a href={`#lesson-${lessonSlug(lesson)}`}>
                          Урок {lessonIndex + 1}. {lesson.data.title}
                        </a>
                      </li>
                    ))}
                  </ol>
                </li>
              );
            })}
          </ol>
        </li>
        <li>
          <span>Проверки модулей</span>
          <ol>
            {modules.map(({ module, checkpoint }, moduleIndex) => (
              <li>
                <a href={`#checkpoint-${moduleSlug(module)}`}>
                  Модуль {moduleIndex + 1}. {checkpoint.data.title}
                </a>
              </li>
            ))}
          </ol>
        </li>
        <li><a href="#capstone">Итоговая работа</a></li>
        <li>
          <span>Ответы и самопроверка</span>
          <ol>
            <li><a href="#knowledge-check-appendix">Ответы к проверкам знаний</a></li>
            <li><a href="#practice-task-appendix">Поддержка практики</a></li>
          </ol>
        </li>
        <li><a href="#sources">Источники</a></li>
      </ol>
    </nav>

    <section
      id="course-overview"
      class="course-pdf__overview"
      data-course-pdf-route={coursePath(course.id)}
      data-course-pdf-required-section
    >
      <h2 class="type-section-title">О курсе</h2>
      <CourseContent components={coursePdfSemanticComponents} />
      <h2 class="type-section-title">Чему ты научишься</h2>
      <ul>
        {course.data.outcomes.map((outcome) => <li>{outcome.statement}</li>)}
      </ul>
      <h2 class="type-section-title">Для кого этот курс</h2>
      <p>{course.data.learnerProfile}</p>
      <h2 class="type-section-title">Что нужно уметь</h2>
      <ul>
        {course.data.prerequisites.map((prerequisite) => <li>{prerequisite}</li>)}
      </ul>
      <h2 class="type-section-title">Объём и актуальность</h2>
      <WorkloadSummary
        label="Объём курса"
        items={[
          { label: "Модули", value: formatModuleCount(tree.modules.length) },
          { label: "Уроки", value: formatLessonCount(lessons.length) },
          { label: "Общее время", value: formatMinutes(courseMinutes(tree)) },
        ]}
      />
    </section>

    {modules.map(({
      module,
      ModuleContent,
      lessons,
      checkpoint,
      CheckpointContent,
    }, moduleIndex) => {
      const currentModuleSlug = moduleSlug(module);
      return (
      <section
        id={`module-${currentModuleSlug}`}
        class="course-pdf__module"
        data-course-pdf-route={modulePath(course.id, currentModuleSlug)}
        data-course-pdf-required-section
      >
        <p class="course-pdf__section-label type-meta">
          Модуль {moduleIndex + 1}
        </p>
        <h2 class="type-page-title">{module.data.title}</h2>
        <p class="course-pdf__summary">{module.data.summary}</p>
        <ModuleContent components={coursePdfSemanticComponents} />

        {lessons.map(({ lesson, LessonContent }, lessonIndex) => (
          <article
            id={`lesson-${lessonSlug(lesson)}`}
            class="course-pdf__lesson"
            data-course-pdf-route={lessonPath(course.id, lessonSlug(lesson))}
            data-course-pdf-required-section
          >
            <p class="course-pdf__section-label type-meta">
              Урок {lessonIndex + 1}
            </p>
            <h3 class="type-section-title">{lesson.data.title}</h3>
            <LessonContent components={coursePdfSemanticComponents} />
          </article>
        ))}

        <article
          id={`checkpoint-${currentModuleSlug}`}
          class="course-pdf__checkpoint"
          data-course-pdf-route={checkpointPath(course.id, currentModuleSlug)}
          data-course-pdf-required-section
        >
          <p class="course-pdf__section-label type-meta">Проверка модуля</p>
          <h3 class="type-section-title">{checkpoint.data.title}</h3>
          <CheckpointContent components={coursePdfSemanticComponents} />
        </article>
      </section>
    );})}

    <section
      id="capstone"
      class="course-pdf__capstone"
      data-course-pdf-route={capstonePath(course.id)}
      data-course-pdf-required-section
    >
      <p class="course-pdf__section-label type-meta">Итоговая работа</p>
      <h2 class="type-page-title">{tree.capstone.data.title}</h2>
      <CapstoneContent components={coursePdfSemanticComponents} />
    </section>

    <section
      id="knowledge-check-appendix"
      class="course-pdf__knowledge-check-appendix"
      data-course-pdf-knowledge-check-appendix
      data-course-pdf-required-section
      hidden
    >
      <h2 class="type-page-title">Ответы к проверкам знаний</h2>
      <div data-course-pdf-knowledge-check-answers />
    </section>

    <section
      id="practice-task-appendix"
      class="course-pdf__practice-task-appendix"
      data-course-pdf-practice-task-appendix
      data-course-pdf-required-section
      hidden
    >
      <h2 class="type-page-title">Поддержка и самопроверка</h2>
      <div data-course-pdf-practice-task-support-list />
    </section>

    <section
      id="sources"
      class="course-pdf__sources"
      data-course-pdf-required-section
      data-course-pdf-sources
      hidden
    >
      <h2 class="type-page-title">Источники</h2>
      <ol data-course-pdf-source-list></ol>
    </section>
  </main>
</CoursePdfLayout>
