---
import BaseLayout from "../layouts/BaseLayout.astro";
import Button from "../components/Button.astro";
import Card from "../components/Card.astro";
import { sitePath } from "../lib/courses";
---
<BaseLayout
  title="Страница недоступна офлайн | Prosto.Courses"
  description="Эта страница не сохранена в текущем каталоге курсов."
>
  <div class="container offline-page">
    <Card
      as="section"
      headingId="offline-heading"
      headingLevel={1}
    >
      <Fragment slot="eyebrow">Сейчас офлайн</Fragment>
      <Fragment slot="title">Эта страница не сохранена</Fragment>
      <Fragment slot="description">
        Адрес мог устареть после обновления каталога. Сохранённые курсы
        по-прежнему доступны.
      </Fragment>
      <Button variant="primary" slot="actions" href={sitePath()}>
        Перейти в каталог курсов
      </Button>
    </Card>
  </div>
</BaseLayout>

<style>
  .offline-page {
    max-width: var(--measure-offline);
    padding-block: var(--space-page-start) var(--space-section-end);
  }
</style>
