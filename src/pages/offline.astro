---
import BaseLayout from "../layouts/BaseLayout.astro";
import { sitePath } from "../lib/courses";
---
<BaseLayout
  title="Страница недоступна офлайн | Prosto.Courses"
  description="Эта страница не сохранена в текущем Каталоге курсов."
>
  <section class="container offline-fallback">
    <p class="eyebrow">Сейчас офлайн</p>
    <h1>Эта страница не сохранена</h1>
    <p>
      Адрес мог устареть после обновления Каталога. Сохранённые курсы по-прежнему
      доступны.
    </p>
    <a class="button" href={sitePath()}>Перейти в Каталог курсов</a>
  </section>
</BaseLayout>

<style>
  .offline-fallback {
    width: min(42rem, calc(100% - 2rem));
    padding-block: 5rem;
  }
  h1 {
    margin: .2rem 0 .8rem;
    font-size: clamp(2.2rem, 7vw, 4rem);
    line-height: 1.05;
    letter-spacing: -.045em;
  }
  p:not(.eyebrow) {
    max-width: 38rem;
    color: var(--color-muted);
    font-size: 1.08rem;
  }
</style>
