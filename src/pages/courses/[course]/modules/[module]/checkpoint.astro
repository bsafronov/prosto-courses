---
import { getCollection, render, type CollectionEntry } from "astro:content";
import CompletionControl from "../../../../../components/CompletionControl.astro";
import LearningPage from "../../../../../components/LearningPage.astro";
import LearningShell from "../../../../../components/LearningShell.astro";
import ProgressStatus from "../../../../../components/ProgressStatus.astro";
import SequenceDestinationLink from "../../../../../components/SequenceDestinationLink.astro";
import { semanticComponents } from "../../../../../components/semantic-components";
import BaseLayout from "../../../../../layouts/BaseLayout.astro";
import {
  capstoneDestinationLink,
  checkpointCourseSlug,
  checkpointDestination,
  checkpointModuleSlug,
  getCoreRouteContext,
  getCourseTree,
  lessonDestinationLink,
  modulePath,
  moduleSlug,
  type CourseModule,
  type CourseTree,
} from "../../../../../lib/courses";

export async function getStaticPaths() {
  const [courses, checkpoints] = await Promise.all([
    getCollection("courses"),
    getCollection("checkpoints"),
  ]);
  const paths = [];
  for (const checkpoint of checkpoints) {
    const courseSlug = checkpointCourseSlug(checkpoint);
    const course = courses.find((candidate) => candidate.id === courseSlug);
    if (!course) continue;
    paths.push({
      params: { course: courseSlug, module: checkpointModuleSlug(checkpoint) },
      props: { course, checkpoint, tree: await getCourseTree(courseSlug) },
    });
  }
  return paths;
}

type Props = {
  course: CollectionEntry<"courses">;
  checkpoint: CollectionEntry<"checkpoints">;
  tree: CourseTree;
};

const { course, checkpoint, tree }: Props = Astro.props;
const slug = checkpointModuleSlug(checkpoint);
const moduleIndex = tree.modules.findIndex(
  (candidate) => moduleSlug(candidate.module) === slug,
);
const currentModule = tree.modules[moduleIndex] as CourseModule;
const nextModule = tree.modules[moduleIndex + 1];
const previousLesson = currentModule.lessons.at(-1)!;
const progress = getCoreRouteContext(
  course.id,
  tree,
  checkpointDestination(slug),
);
const { Content } = await render(checkpoint);
---
<BaseLayout
  title={`${checkpoint.data.title} | ${course.data.title}`}
  mobileTitle={checkpoint.data.title}
  courseRouteControl
>
  <LearningShell
    course={course}
    tree={tree}
    current={{ kind: "checkpoint", slug }}
    destination={progress.current}
  >
    <LearningPage
      eyebrow="Проверка Модуля"
      sequenceLabel="Последовательность курса"
      title={checkpoint.data.title}
    >
      <Fragment slot="header-details">
        <p class="learning-page__summary type-supporting"><a href={modulePath(course.id, slug)}>{currentModule.module.data.title}</a></p>
        <ProgressStatus destination={progress.current} />
      </Fragment>
      <Content components={semanticComponents} />
      <Fragment slot="after-reading">
        <CompletionControl kind="checkpoint" />
      </Fragment>
      <Fragment slot="sequence">
        <SequenceDestinationLink
          destination={lessonDestinationLink(
            course.id,
            previousLesson,
          )}
        >
          ← Последний урок: {previousLesson.data.title}
        </SequenceDestinationLink>
        {nextModule
          ? <a class="sequence-destination-link type-supporting" data-align="end" href={modulePath(course.id, moduleSlug(nextModule.module))}>Перейти к следующему Модулю: {nextModule.module.data.title} →</a>
          : <SequenceDestinationLink
              destination={capstoneDestinationLink(course.id)}
              align="end"
            >
              Перейти к итоговой работе →
            </SequenceDestinationLink>}
      </Fragment>
    </LearningPage>
  </LearningShell>
</BaseLayout>
