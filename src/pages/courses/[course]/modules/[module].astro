---
import { getCollection, render, type CollectionEntry } from "astro:content";
import CourseLessonList from "../../../../components/CourseLessonList.astro";
import ContentFreshness from "../../../../components/ContentFreshness.astro";
import LearningPage from "../../../../components/LearningPage.astro";
import LearningShell from "../../../../components/LearningShell.astro";
import SequenceDestinationLink from "../../../../components/SequenceDestinationLink.astro";
import { semanticComponents } from "../../../../components/semantic-components";
import WorkloadSummary from "../../../../components/WorkloadSummary.astro";
import BaseLayout from "../../../../layouts/BaseLayout.astro";
import {
  checkpointDestinationLink,
  checkpointPath,
  coursePath,
  formatLessonCount,
  getCourseTree,
  getModuleOutcomes,
  formatMinutes,
  lessonDestinationLink,
  lessonPath,
  lessonSlug,
  moduleCourseSlug,
  moduleMinutes,
  moduleFreshnessState,
  moduleSlug,
  type CourseModule,
  type CourseTree,
} from "../../../../lib/courses";

export async function getStaticPaths() {
  const [courses, modules] = await Promise.all([
    getCollection("courses"),
    getCollection("modules"),
  ]);
  const paths = [];
  for (const module of modules) {
    const courseSlug = moduleCourseSlug(module);
    const course = courses.find((candidate) => candidate.id === courseSlug);
    if (!course) continue;
    paths.push({
      params: { course: courseSlug, module: moduleSlug(module) },
      props: { course, module, tree: await getCourseTree(courseSlug) },
    });
  }
  return paths;
}

type Props = {
  course: CollectionEntry<"courses">;
  module: CollectionEntry<"modules">;
  tree: CourseTree;
};

const { course, module, tree }: Props = Astro.props;
const current = tree.modules.find(
  (candidate) => candidate.module.id === module.id,
) as CourseModule;
const modulePosition = tree.modules.findIndex(
  (candidate) => candidate.module.id === module.id,
) + 1;
const previousModule = tree.modules[modulePosition - 2];
const firstLesson = current.lessons[0];
const supportedOutcomes = getModuleOutcomes(course, module);
const slug = moduleSlug(module);
const { Content } = await render(module);
---
<BaseLayout
  title={`${module.data.title} | ${course.data.title}`}
  mobileTitle={module.data.title}
  courseRouteControl
>
  <LearningShell
    course={course}
    tree={tree}
    current={{ kind: "module", slug }}
  >
    <LearningPage
      eyebrow={`Модуль ${modulePosition} из ${tree.modules.length}`}
      sequenceLabel="Последовательность курса"
      title={module.data.title}
    >
      <Fragment slot="header-details">
        <p class="learning-page__summary type-reading">{module.data.summary}</p>
        <WorkloadSummary
          label="Объём Модуля"
          items={[
            { label: "Уроки", value: formatLessonCount(current.lessons.length) },
            { label: "Вместе с проверкой", value: formatMinutes(moduleMinutes(current)) },
          ]}
        />
        <ContentFreshness state={moduleFreshnessState(course, current)} />
        <a
          class="button learning-page__primary-action"
          href={lessonPath(course.id, lessonSlug(current.lessons[0]))}
        >Начать Модуль</a>
      </Fragment>
      <Content components={semanticComponents} />
      <h2>Что ты сможешь после Модуля</h2>
      <p>{module.data.capability}</p>
      <h2>Какие результаты поддерживает Модуль</h2>
      <ul>
        {supportedOutcomes.map((outcome) => (
          <li>{outcome.statement}</li>
        ))}
      </ul>
      <Fragment slot="after-reading">
        <section class="learning-section" aria-labelledby="module-lessons-heading">
          <h2 id="module-lessons-heading" class="learning-section__title type-section-title">Уроки Модуля</h2>
          <CourseLessonList
            courseSlug={course.id}
            lessons={current.lessons}
            label="Уроки Модуля"
          />
          <a class="learning-section__action type-supporting" href={checkpointPath(course.id, slug)}>
            {current.checkpoint.data.title} →
          </a>
        </section>
      </Fragment>
      <Fragment slot="sequence">
          {previousModule
            ? <SequenceDestinationLink
                destination={checkpointDestinationLink(
                  course.id,
                  moduleSlug(previousModule.module),
                )}
              >
                ← Предыдущая проверка Модуля: {previousModule.checkpoint.data.title}
              </SequenceDestinationLink>
            : <a class="sequence-destination-link type-supporting" href={coursePath(course.id)}>← Обзор курса</a>}
          <SequenceDestinationLink
            destination={lessonDestinationLink(course.id, firstLesson)}
            align="end"
          >
            Следующий урок: {firstLesson.data.title} →
          </SequenceDestinationLink>
      </Fragment>
    </LearningPage>
  </LearningShell>
</BaseLayout>
