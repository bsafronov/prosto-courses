---
import { getCollection, render, type CollectionEntry } from "astro:content";
import CourseLessonList from "../../../../components/CourseLessonList.astro";
import ContentFreshness from "../../../../components/ContentFreshness.astro";
import LearningShell from "../../../../components/LearningShell.astro";
import { semanticComponents } from "../../../../components/semantic-components";
import WorkloadSummary from "../../../../components/WorkloadSummary.astro";
import BaseLayout from "../../../../layouts/BaseLayout.astro";
import {
  checkpointPath,
  formatLessonCount,
  getCourseTree,
  getModuleOutcomes,
  formatMinutes,
  lessonPath,
  lessonSlug,
  moduleCourseSlug,
  moduleMinutes,
  moduleFreshnessState,
  moduleSlug,
  type CourseModule,
  type CourseTree,
} from "../../../../lib/courses";

export async function getStaticPaths() {
  const [courses, modules] = await Promise.all([
    getCollection("courses"),
    getCollection("modules"),
  ]);
  const paths = [];
  for (const module of modules) {
    const courseSlug = moduleCourseSlug(module);
    const course = courses.find((candidate) => candidate.id === courseSlug);
    if (!course) continue;
    paths.push({
      params: { course: courseSlug, module: moduleSlug(module) },
      props: { course, module, tree: await getCourseTree(courseSlug) },
    });
  }
  return paths;
}

type Props = {
  course: CollectionEntry<"courses">;
  module: CollectionEntry<"modules">;
  tree: CourseTree;
};

const { course, module, tree }: Props = Astro.props;
const current = tree.modules.find(
  (candidate) => candidate.module.id === module.id,
) as CourseModule;
const modulePosition = tree.modules.findIndex(
  (candidate) => candidate.module.id === module.id,
) + 1;
const supportedOutcomes = getModuleOutcomes(course, module);
const slug = moduleSlug(module);
const { Content } = await render(module);
---
<BaseLayout
  title={`${module.data.title} | ${course.data.title}`}
  mobileTitle={module.data.title}
  courseRouteControl
>
  <LearningShell
    course={course}
    tree={tree}
    current={{ kind: "module", slug }}
  >
    <article class="module-content">
      <header>
        <p class="eyebrow">Модуль {modulePosition} из {tree.modules.length}</p>
        <h1>{module.data.title}</h1>
        <p class="summary">{module.data.summary}</p>
        <WorkloadSummary
          label="Объём Модуля"
          items={[
            { label: "Уроки", value: formatLessonCount(current.lessons.length) },
            { label: "Вместе с проверкой", value: formatMinutes(moduleMinutes(current)) },
          ]}
        />
        <ContentFreshness state={moduleFreshnessState(course, current)} />
        <a
          class="button"
          href={lessonPath(course.id, lessonSlug(current.lessons[0]))}
        >Начать Модуль</a>
      </header>
      <div class="prose">
        <Content components={semanticComponents} />
        <h2>Что ты сможешь после Модуля</h2>
        <p>{module.data.capability}</p>
        <h2>Какие результаты поддерживает Модуль</h2>
        <ul>
          {supportedOutcomes.map((outcome) => (
            <li>{outcome.statement}</li>
          ))}
        </ul>
      </div>
      <section aria-labelledby="module-lessons-heading">
        <h2 id="module-lessons-heading">Уроки Модуля</h2>
        <CourseLessonList
          courseSlug={course.id}
          lessons={current.lessons}
          label="Уроки Модуля"
        />
        <a class="checkpoint" href={checkpointPath(course.id, slug)}>
          {current.checkpoint.data.title} →
        </a>
      </section>
    </article>
  </LearningShell>
</BaseLayout>

<style>
  .module-content {
    width: min(100%, 69ch);
    min-width: 0;
    padding-block: clamp(3rem, 7vw, 6.5rem) 7rem;
  }
  header { border-bottom: 1px solid var(--color-border); padding-bottom: 2rem; }
  h1 {
    margin: .15rem 0 .6rem;
    font-size: clamp(2.7rem, 5.5vw, 5rem);
    font-weight: 600;
    line-height: 1;
    letter-spacing: -.06em;
  }
  .summary { color: var(--color-muted); font-size: 1.1rem; }
  .prose { padding-top: 1rem; }
  section { margin-top: 2.5rem; }
  .checkpoint { display: inline-block; margin-top: 1rem; font-weight: 750; }
  @media (max-width: 52rem) { .module-content { width: 100%; padding-block: 2.5rem 6.5rem; } }
</style>
