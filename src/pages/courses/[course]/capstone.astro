---
import { getCollection, render, type CollectionEntry } from "astro:content";
import CompletionControl from "../../../components/CompletionControl.astro";
import LearningPage from "../../../components/LearningPage.astro";
import LearningShell from "../../../components/LearningShell.astro";
import ProgressStatus from "../../../components/ProgressStatus.astro";
import SequenceDestinationLink from "../../../components/SequenceDestinationLink.astro";
import { semanticComponents } from "../../../components/semantic-components";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import {
  capstoneDestination,
  checkpointDestinationLink,
  coursePath,
  getCoreRouteContext,
  getCourseTree,
  moduleSlug,
  type CourseTree,
} from "../../../lib/courses";

export async function getStaticPaths() {
  const [courses, capstones] = await Promise.all([
    getCollection("courses"),
    getCollection("capstones"),
  ]);
  const paths = [];
  for (const capstone of capstones) {
    const course = courses.find((candidate) => candidate.id === capstone.id);
    if (!course) continue;
    paths.push({
      params: { course: course.id },
      props: { course, capstone, tree: await getCourseTree(course.id) },
    });
  }
  return paths;
}

interface Props {
  course: CollectionEntry<"courses">;
  capstone: CollectionEntry<"capstones">;
  tree: CourseTree;
}

const { course, capstone, tree } = Astro.props;
const finalModule = tree.modules.at(-1)!;
const progress = getCoreRouteContext(
  course.id,
  tree,
  capstoneDestination(),
);
const { Content } = await render(capstone);
---
<BaseLayout
  title={`${capstone.data.title} | ${course.data.title}`}
  mobileTitle={capstone.data.title}
  courseRouteControl
>
  <LearningShell
    course={course}
    tree={tree}
    current={{ kind: "capstone", slug: "capstone" }}
    destination={progress.current}
  >
    <LearningPage
      eyebrow="Итоговая работа"
      sequenceLabel="Последовательность курса"
      title={capstone.data.title}
    >
      <Fragment slot="header-details">
        <p class="learning-page__summary type-supporting">{course.data.title}</p>
        <ProgressStatus destination={progress.current} />
      </Fragment>
      <Content components={semanticComponents} />
      <Fragment slot="after-reading">
        <section class="learning-section reading-flow">
          <h2 class="learning-section__title type-section-title">Критерии готовности</h2>
          <ul aria-label="Критерии итоговой работы">
            {capstone.data.criteria.map((criterion) => <li>{criterion.statement}</li>)}
          </ul>
        </section>
        <CompletionControl kind="capstone" />
      </Fragment>
      <Fragment slot="sequence">
          <SequenceDestinationLink
            destination={checkpointDestinationLink(
              course.id,
              moduleSlug(finalModule.module),
            )}
          >
            ← Проверка модуля: {finalModule.checkpoint.data.title}
          </SequenceDestinationLink>
          <a class="sequence-destination-link type-supporting" data-align="end" href={coursePath(course.id)}>Вернуться к обзору курса →</a>
      </Fragment>
    </LearningPage>
  </LearningShell>
</BaseLayout>
