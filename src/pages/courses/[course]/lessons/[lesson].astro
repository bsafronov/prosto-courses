---
import { getCollection, render, type CollectionEntry } from "astro:content";
import CompletionControl from "../../../../components/CompletionControl.astro";
import LearningPage from "../../../../components/LearningPage.astro";
import LearningShell from "../../../../components/LearningShell.astro";
import ProgressStatus from "../../../../components/ProgressStatus.astro";
import SequenceDestinationLink from "../../../../components/SequenceDestinationLink.astro";
import { semanticComponents } from "../../../../components/semantic-components";
import WorkloadSummary from "../../../../components/WorkloadSummary.astro";
import BaseLayout from "../../../../layouts/BaseLayout.astro";
import {
  checkpointDestinationLink,
  getCoreRouteContext,
  getCourseTree,
  lessonCourseSlug,
  lessonModuleSlug,
  lessonDestination,
  lessonDestinationLink,
  lessonSlug,
  moduleSlug,
  type CourseModule,
  type CourseTree,
} from "../../../../lib/courses";

export async function getStaticPaths() {
  const courses = await getCollection("courses");
  const lessons = await getCollection("lessons");
  const paths = [];
  for (const lesson of lessons) {
    const courseSlug = lessonCourseSlug(lesson);
    const course = courses.find((candidate) => candidate.id === courseSlug);
    if (!course) continue;
    paths.push({
      params: { course: courseSlug, lesson: lessonSlug(lesson) },
      props: { course, lesson, tree: await getCourseTree(courseSlug) },
    });
  }
  return paths;
}

type Props = {
  course: CollectionEntry<"courses">;
  lesson: CollectionEntry<"lessons">;
  tree: CourseTree;
};
const { course, lesson, tree }: Props = Astro.props;
const { Content } = await render(lesson);
const slug = lessonSlug(lesson);
const currentModule = tree.modules.find(
  (candidate) => moduleSlug(candidate.module) === lessonModuleSlug(lesson),
) as CourseModule;
const lessonIndex = currentModule.lessons.findIndex(
  (candidate) => candidate.id === lesson.id,
);
const currentModuleIndex = tree.modules.indexOf(currentModule);
const previous = currentModule.lessons[lessonIndex - 1];
const previousModule = tree.modules[currentModuleIndex - 1];
const next = currentModule.lessons[lessonIndex + 1];
const progress = getCoreRouteContext(
  course.id,
  tree,
  lessonDestination(slug),
);
const lessonTimeItems = [
  { label: "Изучение", value: `${lesson.data.time.study} мин` },
  { label: "Практика", value: `${lesson.data.time.practice} мин` },
  ...(lesson.data.time.advanced === undefined
    ? []
    : [{ label: "Дополнительно", value: `${lesson.data.time.advanced} мин` }]),
];
const routePosition =
  progress.destinations.findIndex(({ id }) => id === progress.current.id) + 1;
---
<BaseLayout
  title={`${lesson.data.title} | ${course.data.title}`}
  mobileTitle={lesson.data.title}
  courseRouteControl
>
  <LearningShell
    course={course}
    tree={tree}
    current={{ kind: "lesson", slug }}
    destination={progress.current}
  >
    <LearningPage
      eyebrow={`Урок ${lessonIndex + 1} из ${currentModule.lessons.length}`}
      eyebrowTechnical
      sequenceLabel="Последовательность уроков"
      title={lesson.data.title}
    >
      <Fragment slot="header-details">
        <div
          class="lesson-utility"
          role="group"
          aria-label="Сведения об Уроке"
        >
          <p class="capability learning-page__summary type-reading">{lesson.data.capability}</p>
          <p class="route-position type-meta type-technical">
            Маршрут: {routePosition} из {progress.destinations.length}
          </p>
          <WorkloadSummary
            label="Время на Урок"
            items={lessonTimeItems}
          />
          <div class="lesson-progress">
            <span class="type-meta">Прогресс Урока</span>
            <ProgressStatus destination={progress.current} />
          </div>
        </div>
      </Fragment>
      <Content components={semanticComponents} />
      <Fragment slot="after-reading">
        <CompletionControl kind="lesson" />
      </Fragment>
      <Fragment slot="sequence">
        {previous
          ? <SequenceDestinationLink
              destination={lessonDestinationLink(
                course.id,
                previous,
              )}
            >
              ← Предыдущий урок: {previous.data.title}
            </SequenceDestinationLink>
          : previousModule
            ? <SequenceDestinationLink
                destination={checkpointDestinationLink(
                  course.id,
                  moduleSlug(previousModule.module),
                )}
              >
                ← Предыдущая проверка Модуля: {previousModule.checkpoint.data.title}
              </SequenceDestinationLink>
          : <span></span>}
        {next
          ? <SequenceDestinationLink
              destination={lessonDestinationLink(
                course.id,
                next,
              )}
              align="end"
            >
              Следующий урок: {next.data.title} →
            </SequenceDestinationLink>
          : <SequenceDestinationLink
              destination={checkpointDestinationLink(
                course.id,
                lessonModuleSlug(lesson),
              )}
              align="end"
            >
              Перейти к проверке Модуля: {currentModule.checkpoint.data.title} →
            </SequenceDestinationLink>}
      </Fragment>
    </LearningPage>
  </LearningShell>
</BaseLayout>

<style>
  .lesson-utility { margin-top: var(--space-5); }
  .route-position {
    margin: var(--space-3) var(--space-0) var(--space-0);
    color: var(--color-muted);
    text-transform: uppercase;
  }
  .lesson-utility :global(.workload) { margin-block: var(--space-3); }
  .lesson-progress {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    color: var(--color-muted);
    text-transform: uppercase;
  }
</style>
