---
import BaseLayout from "../layouts/BaseLayout.astro";
import Card from "../components/Card.astro";
import {
  capstoneDestinationLink,
  checkpointDestinationLink,
  courseMinutes,
  coursePath,
  formatLessonCount,
  formatMinutes,
  formatModuleCount,
  getCourses,
  getCourseTree,
  lessonDestinationLink,
  lessonMinutes,
  moduleSlug,
} from "../lib/courses";
import type {
  HomeCatalogCourse,
  HomeCatalogDestination,
} from "../lib/home-catalog";

const courses = await getCourses();
const catalog = await Promise.all(
  courses.map(async (course) => {
    const tree = await getCourseTree(course.id);
    const progressGroups = tree.modules.map(
      ({ module, lessons, checkpoint }) => ({
        id: moduleSlug(module),
        title: module.data.title,
        destinations: [
        ...lessons.map((lesson) => ({
          ...lessonDestinationLink(course.id, lesson),
          title: lesson.data.title,
          capability: lesson.data.capability,
          moduleTitle: module.data.title,
          minutes: lessonMinutes(lesson),
        })),
        {
          ...checkpointDestinationLink(course.id, moduleSlug(module)),
          title: checkpoint.data.title,
          capability: module.data.capability,
          moduleTitle: module.data.title,
          minutes: checkpoint.data.time,
        },
        ],
      }),
    );
    const capstone = {
      ...capstoneDestinationLink(course.id),
      title: tree.capstone.data.title,
      capability: course.data.summary,
      minutes: tree.capstone.data.time,
    };
    const destinations: HomeCatalogDestination[] = [
      ...progressGroups.flatMap((group) => group.destinations),
      capstone,
    ];
    return {
      course,
      tree,
      lessonCount: tree.modules.reduce(
        (count, courseModule) => count + courseModule.lessons.length,
        0,
      ),
      destinations,
      progressGroups,
      capstone,
    };
  }),
);
const progressCatalog: HomeCatalogCourse[] = catalog.map(
  ({ course, destinations }) => ({
    id: course.id,
    title: course.data.title,
    destinations,
  }),
);
---
<BaseLayout title="Каталог курсов | Prosto.Courses">
  <div data-home-progress data-course-catalog={JSON.stringify(progressCatalog)}>
    <section
      class="home-intro container resume"
      aria-label="Продолжить обучение"
      data-resume-destination
      hidden
    >
      <p class="eyebrow">
        <span>Продолжить обучение</span>
        <span data-resume-course></span>
      </p>
      <h1 class="type-display" data-resume-title></h1>
      <p class="resume-capability type-reading" data-resume-capability></p>
      <p class="resume-context">
        <span data-resume-module hidden></span>
        <span data-resume-position></span>
        <span data-resume-time></span>
        <span data-resume-progress></span>
      </p>
      <a class="resume-action" data-resume-link href={coursePath(catalog[0].course.id)}>
        Продолжить <span aria-hidden="true">→</span>
      </a>
    </section>
    <section class="home-intro container" data-no-progress>
      <p class="eyebrow">Курсы без лишнего шума</p>
      <h1 class="type-display">Выбери Курс и начни с первого Урока.</h1>
      <p class="type-reading">
        Читай, пробуй, отмечай завершённое. Прогресс останется в этом браузере,
        а Каталог можно подготовить для работы офлайн.
      </p>
    </section>
    <section class="container catalog" aria-labelledby="catalog-heading">
    <header class="catalog-heading">
      <div>
        <p class="eyebrow">Каталог курсов</p>
        <h2 id="catalog-heading" class="type-section-title">Все курсы</h2>
      </div>
      <p class="type-meta">
        {catalog.length} {catalog.length === 1 ? "Курс" : "Курса"}
      </p>
    </header>
    <ol class="catalog-list" aria-label="Каталог курсов">
      {catalog.map(({
        course,
        tree,
        lessonCount,
        destinations,
        progressGroups,
        capstone,
      }, index) => (
        <li data-catalog-course={course.id}>
          <Card
            as="article"
            headingId={`course-${course.id}`}
            headingLevel={3}
          >
            <Fragment slot="eyebrow">
              {String(index + 1).padStart(2, "0")}
            </Fragment>
            <a
              class="catalog-title"
              slot="title"
              href={coursePath(course.id)}
            >
              {course.data.title}
            </a>
            <Fragment slot="description">{course.data.summary}</Fragment>
            <div class="catalog-card-content">
              <p class="catalog-meta type-meta">
                <span>{formatModuleCount(tree.modules.length)}</span>
                <span>{formatLessonCount(lessonCount)}</span>
                <span>{formatMinutes(courseMinutes(tree))}</span>
              </p>
              <div class="catalog-route type-meta">
                <div class="catalog-progress-visual" aria-hidden="true">
                  {progressGroups.map((group) => (
                    <span
                      class="module-segment"
                      data-ui-geometry-exception="destination count controls segment ratio"
                      style={`--segment-weight: ${group.destinations.length}`}
                      data-progress-module
                      data-module-id={group.id}
                      data-destination-ids={JSON.stringify(
                        group.destinations.map(({ id }) => id),
                      )}
                      title={group.title}
                    >
                      <span data-progress-module-fill></span>
                    </span>
                  ))}
                  <span
                    class="capstone-marker"
                    data-progress-capstone
                    data-destination-id={capstone.id}
                    data-state="not-started"
                    title="Итоговая работа"
                  ></span>
                </div>
                <ol
                  class="sr-only"
                  aria-label={`Компактный маршрут курса: ${course.data.title}`}
                >
                  {destinations.map((destination) => (
                    <li>
                      {destination.title}:{" "}
                      <span
                        data-catalog-destination-status
                        data-destination-id={destination.id}
                      >
                        Не начато
                      </span>
                    </li>
                  ))}
                </ol>
                <span data-catalog-progress>Не начат</span>
                <span class="catalog-updates" data-catalog-updates hidden></span>
              </div>
            </div>
            <a class="catalog-open" slot="actions" href={coursePath(course.id)}>
              Открыть Курс <span aria-hidden="true">→</span>
            </a>
          </Card>
        </li>
      ))}
    </ol>
  </section>
  </div>
  <script src="../scripts/home-progress.ts"></script>
</BaseLayout>

<style>
  .home-intro { padding-block: var(--space-page-start) var(--space-page-end); }
  .home-intro h1 {
    max-width: var(--measure-display);
    margin: var(--space-0);
  }
  .home-intro > p:last-child {
    max-width: var(--measure-copy);
    margin-top: var(--space-5);
    color: var(--color-muted);
  }
  .home-intro[hidden] { display: none; }
  .resume .eyebrow {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-4);
  }
  .resume .eyebrow span + span::before {
    margin-right: var(--space-4);
    color: var(--color-border);
    content: "/";
  }
  .resume-capability {
    max-width: var(--measure-copy);
    margin: var(--space-5) var(--space-0) var(--space-0);
    color: var(--color-muted);
  }
  .resume-context, .catalog-meta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-5);
    color: var(--color-muted);
  }
  .resume-context span:not([hidden]) + span:not([hidden])::before {
    margin-right: var(--space-5);
    content: "·";
  }
  .resume-action {
    display: inline-flex;
    align-items: center;
    gap: var(--space-3);
    border-bottom: var(--border-width-thin) solid var(--color-ink);
    margin-top: var(--space-6);
    color: var(--color-ink);
    font-weight: var(--font-weight-semibold);
    text-decoration: none;
  }
  .catalog { padding-block: var(--space-10) var(--space-section-end); }
  .catalog-heading {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: var(--space-4);
    margin-bottom: var(--space-6);
  }
  .catalog-heading p { margin-block: 0; }
  .catalog-heading h2 { margin: var(--space-0); }
  .catalog-heading > p {
    color: var(--color-muted);
  }
  .catalog-list {
    display: grid;
    gap: var(--space-6);
    margin: var(--space-0);
    padding: var(--space-0);
    list-style: none;
  }
  .catalog-list > li { min-width: 0; }
  .catalog-title { color: var(--color-ink); text-decoration: none; }
  .catalog-card-content {
    display: flex;
    min-width: 0;
    flex-wrap: wrap;
    align-items: end;
    gap: var(--space-4) var(--space-8);
  }
  .catalog-meta { flex: 1 1 var(--measure-compact); margin: var(--space-0); }
  .catalog-meta span + span::before {
    margin-right: var(--space-5);
    content: "·";
  }
  .catalog-route {
    display: grid;
    min-width: 0;
    flex: 1 1 var(--measure-compact);
    gap: var(--space-3);
    color: var(--color-muted);
  }
  .catalog-progress-visual {
    display: flex;
    min-width: 0;
    align-items: center;
    gap: var(--space-1);
  }
  .module-segment {
    position: relative;
    height: var(--border-width-progress);
    flex: var(--segment-weight) 1 0;
    border-radius: var(--radius-round);
    overflow: hidden;
    background: var(--color-border);
  }
  .module-segment > span {
    display: block;
    width: 0;
    height: 100%;
    border-radius: inherit;
    background: var(--color-ink);
    transition: width var(--motion-duration) var(--motion-easing);
  }
  .capstone-marker {
    position: relative;
    display: grid;
    width: var(--progress-marker-size);
    height: var(--progress-marker-size);
    flex: 0 0 auto;
    place-items: center;
    border: var(--border-subtle);
    border-radius: 50%;
  }
  .capstone-marker::after {
    width: var(--progress-marker-dot-size);
    height: var(--progress-marker-dot-size);
    border-radius: 50%;
    background: var(--color-ink);
    content: "";
    opacity: 0;
    transform: scale(50%);
    transition:
      opacity var(--motion-duration) var(--motion-easing),
      transform var(--motion-duration) var(--motion-easing);
  }
  .capstone-marker[data-state="completed"]::after {
    opacity: 1;
    transform: scale(1);
  }
  .catalog-updates {
    margin-top: calc(-1 * var(--space-2));
    color: var(--color-warning);
  }
  .catalog-open {
    color: var(--color-ink);
    font-size: var(--font-size-supporting);
    font-weight: var(--font-weight-semibold);
    line-height: var(--line-height-supporting);
    text-decoration: none;
    white-space: nowrap;
  }
  @media (prefers-reduced-motion: reduce) {
    .module-segment > span,
    .capstone-marker::after { transition: none; }
  }
</style>
