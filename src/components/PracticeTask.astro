---
import Button from "./Button.astro";
import Card from "./Card.astro";

interface Props {
  id?: string;
  title: string;
  level: "core" | "challenge" | "stretch";
  estimatedMinutes: number;
  goal: string;
  outcomes: string[];
  constraints?: string[];
  criteria: string[];
  hints?: string[];
}

const levelLabels = {
  core: "Основная практика",
  challenge: "Практика с вызовом",
  stretch: "Дополнительная практика",
} satisfies Record<Props["level"], string>;

const {
  id,
  title,
  level,
  estimatedMinutes,
  goal,
  constraints = [],
  criteria,
  hints = [],
} = Astro.props;
const taskId = `practice-task-${Math.random().toString(36).slice(2)}`;
const titleId = `${taskId}-title`;
---

<Card
  as="section"
  class="practice-task type-body"
  headingId={titleId}
  headingLevel={2}
  data-practice-task
  data-interaction-id={id}
  role="region"
>
  <Fragment slot="eyebrow">
    {levelLabels[level]} · {estimatedMinutes} мин
  </Fragment>
  <Fragment slot="title">{title}</Fragment>
  <Fragment slot="description"><strong>Цель:</strong> {goal}</Fragment>
  {
    constraints.length > 0 && (
      <section class="task-list" aria-label="Ограничения">
        <h3 class="type-body">Ограничения</h3>
        <ul>
          {constraints.map((constraint) => <li>{constraint}</li>)}
        </ul>
      </section>
    )
  }
  <section class="task-list" aria-label="Критерии готовности">
    <h3 class="type-body">Критерии готовности</h3>
    <ul>
      {criteria.map((criterion) => <li>{criterion}</li>)}
    </ul>
  </section>
  <div class="prompt" data-task-prompt>
    <h3 class="type-body">Задание</h3>
    <slot />
  </div>
  {
    hints.length > 0 && (
      <section class="support" aria-label="Подсказки">
        <h3 class="type-body">Подсказки</h3>
        <p class="type-supporting">
          Открывай их по одной — от общего направления к конкретному шагу.
        </p>
        <ol aria-label="Открытые подсказки" aria-live="polite">
          {hints.map((hint) => <li data-task-hint hidden>{hint}</li>)}
        </ol>
        <Button
          variant="primary"
          type="button"
          data-task-hint-reveal
          data-hint-count={hints.length}
        >
          Показать подсказку 1 из {hints.length}
        </Button>
      </section>
    )
  }
  <div data-task-feedback-destination></div>
</Card>

<script>
  function initialisePracticeTask(task: HTMLElement) {
    if (task.dataset.ready) return;
    task.dataset.ready = "true";

    const prompt = task.querySelector<HTMLElement>("[data-task-prompt]");
    const feedbackDestination = task.querySelector<HTMLElement>(
      "[data-task-feedback-destination]",
    );
    const feedback = prompt?.querySelector<HTMLElement>(
      "[data-task-feedback]",
    );
    if (feedback && feedbackDestination) {
      feedbackDestination.append(feedback);
    }

    const reveal = task.querySelector<HTMLButtonElement>(
      "[data-task-hint-reveal]",
    );
    const hints = [
      ...task.querySelectorAll<HTMLElement>("[data-task-hint]"),
    ];
    if (!reveal || hints.length === 0) return;

    let revealed = 0;
    reveal.addEventListener("click", () => {
      hints[revealed]?.removeAttribute("hidden");
      revealed += 1;
      if (revealed === hints.length) {
        reveal.textContent = "Все подсказки открыты";
        reveal.disabled = true;
      } else {
        reveal.textContent =
          `Показать подсказку ${revealed + 1} из ${hints.length}`;
      }
    });
  }

  document
    .querySelectorAll<HTMLElement>("[data-practice-task]")
    .forEach(initialisePracticeTask);
</script>

<style>
  :global(.practice-task) {
    margin-block: var(--space-8);
    overflow: hidden;
  }
  :global(.practice-task .task-list),
  :global(.practice-task .prompt),
  :global(.practice-task .support) {
    margin: var(--space-0);
    border: var(--space-0);
    border-top: var(--border-subtle);
    border-radius: var(--space-0);
    padding-block: var(--space-4);
    background: transparent;
  }
  :global(.practice-task h3) {
    margin: var(--space-0) var(--space-0) var(--space-2);
    font-weight: var(--font-weight-bold);
  }
  :global(.practice-task .task-list ul),
  :global(.practice-task .support ol) {
    margin: var(--space-2) var(--space-0) var(--space-0);
    padding-left: var(--space-6);
  }
  :global(.practice-task .prompt p:first-of-type) { margin-top: var(--space-0); }
  :global(.practice-task .prompt p:last-of-type) { margin-bottom: var(--space-0); }
  :global(.practice-task [data-task-feedback-destination]:not(:empty)) {
    border-top: var(--border-subtle);
    padding-top: var(--space-4);
  }
  :global(.practice-task .support p) {
    margin: var(--space-0) var(--space-0) var(--space-3);
    color: var(--color-muted);
  }
  :global(.practice-task .support li) { margin-block: var(--space-2); }
  :global(.practice-task .support button) { margin-top: var(--space-3); }
  @media (max-width: 36rem) {
    :global(.practice-task .support button) { width: 100%; }
  }
</style>
