---
interface Props {
  title: string;
  level: "core" | "challenge" | "stretch";
  estimatedMinutes: number;
  goal: string;
  outcomes: string[];
  constraints?: string[];
  criteria: string[];
  hints?: string[];
}

const levelLabels = {
  core: "Основная практика",
  challenge: "Практика с вызовом",
  stretch: "Дополнительная практика",
} satisfies Record<Props["level"], string>;

const {
  title,
  level,
  estimatedMinutes,
  goal,
  constraints = [],
  criteria,
  hints = [],
} = Astro.props;
const taskId = `practice-task-${Math.random().toString(36).slice(2)}`;
const titleId = `${taskId}-title`;
---

<section
  class="practice-task work-area"
  data-practice-task
  role="region"
  aria-labelledby={titleId}
>
  <header>
    <p class="work-area__eyebrow">
      {levelLabels[level]} · {estimatedMinutes} мин
    </p>
    <h2 id={titleId}>{title}</h2>
    <p class="goal"><strong>Цель:</strong> {goal}</p>
  </header>
  {
    constraints.length > 0 && (
      <section class="task-list" aria-label="Ограничения">
        <h3>Ограничения</h3>
        <ul>
          {constraints.map((constraint) => <li>{constraint}</li>)}
        </ul>
      </section>
    )
  }
  <section class="task-list" aria-label="Критерии готовности">
    <h3>Критерии готовности</h3>
    <ul>
      {criteria.map((criterion) => <li>{criterion}</li>)}
    </ul>
  </section>
  <div class="prompt" data-task-prompt>
    <h3>Задание</h3>
    <slot />
  </div>
  {
    hints.length > 0 && (
      <section class="support" aria-label="Подсказки">
        <h3>Подсказки</h3>
        <p>Открывай их по одной — от общего направления к конкретному шагу.</p>
        <ol aria-label="Открытые подсказки" aria-live="polite">
          {hints.map((hint) => <li data-task-hint hidden>{hint}</li>)}
        </ol>
        <button
          type="button"
          data-task-hint-reveal
          data-hint-count={hints.length}
        >
          Показать подсказку 1 из {hints.length}
        </button>
      </section>
    )
  }
  <div data-task-feedback-destination></div>
</section>

<script>
  function initialisePracticeTask(task: HTMLElement) {
    if (task.dataset.ready) return;
    task.dataset.ready = "true";

    const prompt = task.querySelector<HTMLElement>("[data-task-prompt]");
    const feedbackDestination = task.querySelector<HTMLElement>(
      "[data-task-feedback-destination]",
    );
    const feedback = prompt?.querySelector<HTMLElement>(
      "[data-task-feedback]",
    );
    if (feedback && feedbackDestination) {
      feedbackDestination.append(feedback);
    }

    const reveal = task.querySelector<HTMLButtonElement>(
      "[data-task-hint-reveal]",
    );
    const hints = [
      ...task.querySelectorAll<HTMLElement>("[data-task-hint]"),
    ];
    if (!reveal || hints.length === 0) return;

    let revealed = 0;
    reveal.addEventListener("click", () => {
      hints[revealed]?.removeAttribute("hidden");
      revealed += 1;
      if (revealed === hints.length) {
        reveal.textContent = "Все подсказки открыты";
        reveal.disabled = true;
      } else {
        reveal.textContent =
          `Показать подсказку ${revealed + 1} из ${hints.length}`;
      }
    });
  }

  document
    .querySelectorAll<HTMLElement>("[data-practice-task]")
    .forEach(initialisePracticeTask);
</script>

<style>
  .practice-task {
    margin: 2rem 0;
    overflow: hidden;
  }
  header { padding: 1.25rem; }
  h2 { margin: 0; font-size: 1.35rem; }
  h3 { margin: 0 0 .45rem; font-size: 1rem; }
  .goal { margin: .65rem 0 0; color: var(--color-muted); }
  .task-list, .prompt, .support {
    margin: 0;
    border: 0;
    border-top: 1px solid var(--color-border);
    border-radius: 0;
    padding: 1rem 1.25rem;
    background: transparent;
  }
  .task-list ul, .support ol { margin: .4rem 0 0; padding-left: 1.35rem; }
  .prompt :global(p:first-of-type) { margin-top: 0; }
  .prompt :global(p:last-of-type) { margin-bottom: 0; }
  [data-task-feedback-destination]:not(:empty) {
    border-top: 1px solid var(--color-border);
    padding: 1rem 1.25rem 1.25rem;
  }
  .support p { margin: 0 0 .7rem; color: var(--color-muted); font-size: .92rem; }
  .support li { margin: .35rem 0; }
  .support button { margin-top: .75rem; }
  @media (max-width: 34rem) {
    header,
    .task-list,
    .prompt,
    .support,
    [data-task-feedback-destination]:not(:empty) {
      padding-inline: 1rem;
    }
    .support button { width: 100%; }
  }
</style>
