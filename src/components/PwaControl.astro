---
import { sitePath } from "../lib/courses";
---

<div
  class="pwa-control"
  data-pwa-control
  data-catalog-url={sitePath()}
  data-release-url={sitePath("offline-release.json")}
  role="group"
  aria-label="Приложение и офлайн-доступ"
  hidden
>
  <span class="pwa-indicator" aria-hidden="true"></span>
  <span
    class="pwa-status"
    data-pwa-status
    aria-live="polite"
    aria-atomic="true"
  ></span>
  <span
    class="pwa-detail"
    data-pwa-detail
    id="pwa-action-detail"
    hidden
  ></span>
  <button
    class="pwa-action button-secondary"
    data-pwa-action
    type="button"
    aria-describedby="pwa-action-detail"
    hidden
  ></button>
</div>

<script>
  import { initialisePwaControls } from "../scripts/pwa-controller";

  initialisePwaControls();
</script>

<style>
  .pwa-control {
    position: relative;
    display: inline-flex;
    min-width: 0;
    min-height: var(--control-min-height);
    align-items: center;
    gap: var(--space-2);
    border: var(--border-subtle);
    border-radius: var(--radius);
    padding: var(--space-1) var(--space-2);
    background: var(--color-surface);
    color: var(--color-muted);
    font-family: var(--font-sans);
    font-size: var(--font-size-supporting);
    line-height: var(--line-height-supporting);
  }
  .pwa-control[hidden] { display: none; }
  .pwa-control[data-quiet="true"] {
    min-height: auto;
    border: 0;
    padding: 0;
    background: transparent;
  }
  .pwa-indicator {
    width: var(--progress-marker-size);
    height: var(--progress-marker-size);
    flex: 0 0 auto;
    border: var(--border-width-thin) solid currentColor;
    border-radius: var(--radius-round);
    background: var(--color-canvas);
  }
  .pwa-indicator[hidden] { display: none; }
  .pwa-control[data-status="preparing"] .pwa-indicator,
  .pwa-control[data-status="deferred"] .pwa-indicator {
    border-color: var(--color-warning);
    background: var(--color-started);
  }
  .pwa-control[data-status="offline"] .pwa-indicator,
  .pwa-control[data-status="failure"] .pwa-indicator {
    border-color: var(--color-error);
    background: var(--color-error);
  }
  .pwa-status {
    min-width: 0;
    color: var(--color-ink);
    font-weight: var(--font-weight-semibold);
    overflow-wrap: anywhere;
  }
  .pwa-status[hidden] { display: none; }
  .pwa-detail { max-width: var(--measure-control-detail); }
  .pwa-action {
    padding-inline: var(--control-padding-inline-compact);
    white-space: nowrap;
  }
  @media (max-width: 42rem) {
    .pwa-control { max-width: 100%; flex-wrap: wrap; }
    .pwa-detail { order: 3; flex-basis: 100%; }
  }
</style>
