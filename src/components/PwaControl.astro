---
import { sitePath } from "../lib/courses";
---

<div
  class="pwa-control"
  data-pwa-control
  data-catalog-url={sitePath()}
  data-release-url={sitePath("offline-release.json")}
  role="group"
  aria-label="Офлайн-доступ"
  hidden
>
  <span class="pwa-indicator" aria-hidden="true"></span>
  <span
    class="pwa-status"
    data-pwa-status
    aria-live="polite"
    aria-atomic="true"
  ></span>
  <span
    class="pwa-detail"
    data-pwa-detail
    id="pwa-action-detail"
    hidden
  ></span>
  <button
    class="pwa-action"
    data-pwa-action
    type="button"
    aria-describedby="pwa-action-detail"
    hidden
  ></button>
</div>

<script>
  import { initialisePwaControls } from "../scripts/pwa-controller";

  initialisePwaControls();
</script>

<style>
  .pwa-control {
    position: relative;
    display: inline-flex;
    min-height: 2.35rem;
    align-items: center;
    gap: .5rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    padding: .3rem .35rem .3rem .6rem;
    background: var(--color-surface);
    color: var(--color-muted);
    font-family: var(--font-mono);
    font-size: .82rem;
    line-height: 1.25;
  }
  .pwa-control[hidden] { display: none; }
  .pwa-indicator {
    width: .55rem;
    height: .55rem;
    flex: 0 0 auto;
    border: 1px solid currentColor;
    border-radius: 50%;
    background: var(--color-canvas);
  }
  .pwa-control[data-status="preparing"] .pwa-indicator,
  .pwa-control[data-status="deferred"] .pwa-indicator {
    border-color: var(--color-warning);
    background: var(--color-started);
  }
  .pwa-control[data-status="ready"] .pwa-indicator {
    border-color: var(--color-completed-ink);
    background: var(--color-completed-ink);
  }
  .pwa-control[data-status="offline"] .pwa-indicator,
  .pwa-control[data-status="failure"] .pwa-indicator {
    border-color: var(--color-error);
    background: var(--color-error);
  }
  .pwa-status { color: var(--color-ink); font-weight: 750; white-space: nowrap; }
  .pwa-detail { max-width: 24rem; }
  .pwa-action {
    min-height: 1.75rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    padding: .2rem .55rem;
    background: var(--color-canvas);
    color: var(--color-ink);
    font-size: .8rem;
    white-space: nowrap;
  }
  .pwa-action:hover { background: var(--color-ink); color: var(--color-canvas); }
  .pwa-action:disabled { cursor: not-allowed; opacity: .55; }
  @media (max-width: 42rem) {
    .pwa-control { max-width: 100%; flex-wrap: wrap; }
    .pwa-detail { order: 3; flex-basis: 100%; }
  }
</style>
