---
import { X } from "@lucide/astro";
import type {
  CoreDestinationLink,
  CourseEntry,
  CourseTree,
} from "../lib/courses";
import { coursePath, getCoreDestinationLinks } from "../lib/courses";
import Button from "./Button.astro";
import CourseOutline from "./CourseOutline.astro";

interface Props {
  course: CourseEntry;
  tree: CourseTree;
  current: {
    kind: "module" | "lesson" | "checkpoint" | "capstone";
    slug: string;
  };
  destination?: CoreDestinationLink;
}

const { course, tree, current, destination } = Astro.props;
const destinations = getCoreDestinationLinks(course.id, tree);
---

<div
  class="container learning-shell"
  data-progress-root
  data-course-slug={course.id}
  data-current-destination={destination?.id}
  data-core-destinations={JSON.stringify(destinations)}
>
  <aside class="course-route-panel" id="course-route-panel" data-course-route-panel>
    <div class="route-mobile-head">
      <span id="course-route-title" class="type-supporting">Маршрут курса</span>
      <Button
        variant="ghost"
        iconOnly
        type="button"
        data-course-route-close
        aria-label="Закрыть маршрут курса"
      ><X aria-hidden="true" /></Button>
    </div>
    <nav aria-label="Навигация по курсу">
      <header class="route-head">
        <span class="type-meta">Маршрут курса</span>
        <strong class="type-supporting">{course.data.title}</strong>
        <a class="link-control type-meta" href={coursePath(course.id)}>О курсе</a>
        <p class="type-meta" data-course-progress role="status" aria-live="polite">Не начат</p>
        <p class="route-guidance type-meta">
          Рекомендуемая последовательность не ограничивает переходы — можно
          открыть любую часть Курса.
        </p>
        <span class="route-progress" aria-hidden="true">
          <span data-course-progress-line></span>
        </span>
      </header>
      <CourseOutline
        courseSlug={course.id}
        tree={tree}
        lessonListLabel="Уроки в навигации курса"
        current={current}
      />
    </nav>
  </aside>

  <div class="learning-content"><slot /></div>

  <Button
    variant="bare"
    type="button"
    class="course-route-backdrop"
    data-course-route-backdrop
    aria-hidden="true"
    tabindex="-1"
    hidden
  ></Button>
</div>

<script>
  function initialiseCourseRoute(root: HTMLElement) {
    const panel = root.querySelector<HTMLElement>("[data-course-route-panel]");
    const toggle = document.querySelector<HTMLButtonElement>(
      "[data-course-route-toggle]",
    );
    const close = root.querySelector<HTMLButtonElement>(
      "[data-course-route-close]",
    );
    const backdrop = root.querySelector<HTMLButtonElement>(
      "[data-course-route-backdrop]",
    );
    const mobile = window.matchMedia("(max-width: 52rem)");
    if (!panel || !toggle || !close || !backdrop) return;
    const courseRoute = panel;
    const routeToggle = toggle;
    const closeControl = close;
    const routeBackdrop = backdrop;

    let returnFocus: HTMLElement | null = null;

    function setClosedAccessibility() {
      if (mobile.matches) {
        courseRoute.inert = true;
        courseRoute.setAttribute("aria-hidden", "true");
      } else {
        courseRoute.inert = false;
        courseRoute.removeAttribute("aria-hidden");
      }
    }

    function openDrawer() {
      returnFocus =
        document.activeElement instanceof HTMLElement
          ? document.activeElement
          : routeToggle;
      courseRoute.inert = false;
      courseRoute.removeAttribute("aria-hidden");
      courseRoute.setAttribute("role", "dialog");
      courseRoute.setAttribute("aria-modal", "true");
      courseRoute.setAttribute("aria-labelledby", "course-route-title");
      document.body.dataset.courseRouteOpen = "true";
      routeToggle.setAttribute("aria-expanded", "true");
      routeBackdrop.hidden = false;
      closeControl.focus();
    }

    function closeDrawer(restoreFocus = false) {
      delete document.body.dataset.courseRouteOpen;
      routeToggle.setAttribute("aria-expanded", "false");
      courseRoute.removeAttribute("role");
      courseRoute.removeAttribute("aria-modal");
      courseRoute.removeAttribute("aria-labelledby");
      routeBackdrop.hidden = true;
      setClosedAccessibility();
      if (restoreFocus) returnFocus?.focus();
    }

    routeToggle.addEventListener("click", () => {
      if (document.body.dataset.courseRouteOpen === "true") {
        closeDrawer(true);
      } else {
        openDrawer();
      }
    });
    closeControl.addEventListener("click", () => closeDrawer(true));
    routeBackdrop.addEventListener("click", () => closeDrawer(true));
    courseRoute.addEventListener("click", (event) => {
      if (event.target instanceof HTMLAnchorElement && mobile.matches) {
        closeDrawer();
      }
    });
    window.addEventListener("keydown", (event) => {
      if (document.body.dataset.courseRouteOpen !== "true") return;
      if (event.key === "Escape") {
        event.preventDefault();
        closeDrawer(true);
        return;
      }
      if (event.key !== "Tab") return;
      const focusable = [
        ...courseRoute.querySelectorAll<HTMLElement>(
          'a[href], button:not([disabled]), [tabindex]:not([tabindex="-1"])',
        ),
      ];
      const first = focusable[0];
      const last = focusable.at(-1);
      if (!first || !last) return;
      if (event.shiftKey && document.activeElement === first) {
        event.preventDefault();
        last.focus();
      } else if (!event.shiftKey && document.activeElement === last) {
        event.preventDefault();
        first.focus();
      }
    });
    mobile.addEventListener("change", () => closeDrawer());
    setClosedAccessibility();
  }

  document
    .querySelectorAll<HTMLElement>("[data-progress-root]")
    .forEach(initialiseCourseRoute);
</script>

<script src="../scripts/progress.ts"></script>

<style>
  .learning-shell {
    display: grid;
    grid-template-columns: var(--measure-course-route) minmax(0, 1fr);
    gap: var(--space-learning-columns);
    align-items: start;
  }
  .course-route-panel {
    position: sticky;
    top: calc(var(--shell-header-min-height) + var(--space-6));
    width: var(--measure-course-route);
    max-height: calc(
      var(--viewport-height) - var(--shell-header-min-height) - var(--space-12)
    );
    padding-block: var(--space-10);
    overflow-y: auto;
    overscroll-behavior: contain;
  }
  .route-mobile-head { display: none; }
  .route-head { margin-bottom: var(--space-8); }
  .route-head > span:first-child,
  .route-head [data-course-progress] {
    margin: var(--space-0);
    color: var(--color-muted);
    text-transform: uppercase;
  }
  .route-guidance {
    color: var(--color-muted);
  }
  .route-head > strong {
    display: block;
    margin: var(--space-2) var(--space-0);
    color: var(--color-ink);
    letter-spacing: var(--tracking-title);
  }
  .route-head > a {
    color: var(--color-muted);
    text-decoration: none;
  }
  .route-progress {
    display: block;
    height: var(--border-width-emphasis);
    margin-top: var(--space-3);
    background: var(--color-border);
  }
  .route-progress > span {
    display: block;
    width: 0;
    height: 100%;
    background: var(--color-ink);
    transition: width var(--motion-duration) var(--motion-easing);
  }
  .learning-content { min-width: 0; }
  .course-route-backdrop[hidden] { display: none; }
  @media (max-width: 52rem) {
    .learning-shell {
      display: block;
    }
    .course-route-panel {
      position: fixed;
      z-index: var(--layer-drawer);
      top: var(--shell-header-min-height);
      bottom: 0;
      left: 0;
      width: min(calc(100% - var(--space-8)), var(--measure-detail));
      max-height: none;
      border-right: var(--border-subtle);
      padding: var(--space-0) var(--space-5) var(--space-12);
      background: var(--color-canvas);
      box-shadow: var(--shadow);
      transform: translateX(-105%);
      visibility: hidden;
      transition:
        transform var(--motion-duration) var(--motion-easing),
        visibility 0s var(--motion-easing) var(--motion-duration);
    }
    body[data-course-route-open="true"] .course-route-panel {
      transform: translateX(0);
      visibility: visible;
      transition-delay: 0s;
    }
    body[data-course-route-open="true"] { overflow: hidden; }
    .route-mobile-head {
      position: sticky;
      z-index: var(--layer-raised);
      top: 0;
      display: flex;
      min-height: calc(var(--control-min-height) + var(--space-4));
      align-items: center;
      justify-content: space-between;
      border-bottom: var(--border-subtle);
      margin-bottom: var(--space-4);
      background: var(--color-canvas);
      font-weight: var(--font-weight-semibold);
    }
    .course-route-backdrop {
      position: fixed;
      z-index: var(--layer-backdrop);
      inset: var(--shell-header-min-height) 0 0;
      width: 100%;
      min-height: 0;
      border: var(--space-0);
      border-radius: var(--space-0);
      padding: var(--space-0);
      background: var(--color-backdrop);
    }
    .course-route-backdrop:hover { background: var(--color-backdrop); }
  }
  @media (prefers-reduced-motion: reduce) {
    .course-route-panel, .route-progress > span { transition: none; }
  }
</style>
