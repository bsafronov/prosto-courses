---
import { createHash } from "node:crypto";
import Button from "./Button.astro";
import Card from "./Card.astro";

interface ChoiceOption {
  id: string;
  text: string;
  feedback: string;
}

interface MatchingPair {
  id: string;
  left: string;
  right: string;
  feedback: string;
}

interface OrderingItem {
  id: string;
  text: string;
}

interface ExactNormalization {
  trim: boolean;
  case: "sensitive" | "insensitive";
}

interface SharedProps {
  prompt: string;
  outcomes: string[];
  explanation: string;
}

type Props =
  | (SharedProps & {
      type: "single";
      options: ChoiceOption[];
      answer: string;
    })
  | (SharedProps & {
      type: "multiple";
      options: ChoiceOption[];
      answer: string[];
    })
  | (SharedProps & { type: "matching"; pairs: MatchingPair[] })
  | (SharedProps & { type: "ordering"; items: OrderingItem[] })
  | (SharedProps & {
      type: "exact";
      acceptedAnswers: string[];
      normalization: ExactNormalization;
    })
  | (SharedProps & {
      type: "numeric";
      answer: number;
      tolerance: number;
      unit?: string;
    });

function shuffleAwayFromAuthoredOrder<T>(values: T[]) {
  const shuffled = [...values];
  for (let index = shuffled.length - 1; index > 0; index -= 1) {
    const target = Math.floor(Math.random() * (index + 1));
    [shuffled[index], shuffled[target]] = [shuffled[target], shuffled[index]];
  }
  if (
    shuffled.length > 1 &&
    shuffled.every((value, index) => value === values[index])
  ) {
    shuffled.push(shuffled.shift() as T);
  }
  return shuffled;
}

function opaqueResponseKey(kind: "matching" | "ordering", authoredId: string) {
  return createHash("sha256")
    .update(`${kind}\0${authoredId}`)
    .digest("base64url")
    .slice(0, 16);
}

const props = Astro.props;
const { type, prompt, explanation } = props;
const inputName = `knowledge-check-${crypto.randomUUID()}`;
const titleId = `${inputName}-title`;
const orderingListId = `${inputName}-ordering-list`;
const orderingInstructionsId = `${inputName}-ordering-instructions`;
const options = "options" in props ? props.options : [];
const matchingRows =
  type === "matching"
    ? props.pairs.map((pair) => ({
        answerKey: opaqueResponseKey("matching", pair.id),
        feedback: pair.feedback,
        left: pair.left,
        right: pair.right,
      }))
    : [];
const matchingOptions = shuffleAwayFromAuthoredOrder(
  matchingRows.map(({ answerKey, right }) => ({ answerKey, right })),
);
const authoredOrderingRows =
  type === "ordering"
    ? props.items.map((item) => ({
        answerKey: opaqueResponseKey("ordering", item.id),
        text: item.text,
      }))
    : [];
const orderingRows = shuffleAwayFromAuthoredOrder(authoredOrderingRows);
const authoredAnswer =
  type === "matching"
    ? matchingRows.map(({ answerKey }) => answerKey)
    : type === "ordering"
      ? authoredOrderingRows.map(({ answerKey }) => answerKey)
      : type === "exact"
        ? props.acceptedAnswers
        : props.answer;
const authoredNormalization =
  type === "exact" ? JSON.stringify(props.normalization) : undefined;
const numericTolerance = type === "numeric" ? props.tolerance : undefined;
const numericUnit = type === "numeric" ? props.unit : undefined;
---

<Card
  as="form"
  class="knowledge-check type-body"
  headingId={titleId}
  headingLevel={2}
  data-knowledge-check
  data-type={type}
  data-answer={JSON.stringify(authoredAnswer)}
  data-normalization={authoredNormalization}
  data-tolerance={numericTolerance}
>
  <Fragment slot="eyebrow">Проверь себя</Fragment>
  <Fragment slot="title">{prompt}</Fragment>
  <fieldset aria-labelledby={titleId}>
    {
      (type === "single" || type === "multiple") && (
        <div class="options">
          {options.map((option) => (
            <label>
              <input
                type={type === "single" ? "radio" : "checkbox"}
                name={inputName}
                value={option.id}
                data-option-feedback={option.feedback}
                required={type === "single"}
              />
              <span>{option.text}</span>
            </label>
          ))}
        </div>
      )
    }
    {
      type === "matching" && (
        <div class="matching-list">
          {matchingRows.map((row) => (
            <label class="matching-row">
              <span>{row.left}</span>
              <select
                aria-label={`Соответствие для «${row.left}»`}
                data-match
                data-match-feedback={row.feedback}
                data-match-left={row.left}
              >
                <option value="">Выбери соответствие</option>
                {matchingOptions.map((option) => (
                  <option value={option.answerKey}>{option.right}</option>
                ))}
              </select>
            </label>
          ))}
        </div>
      )
    }
    {
      type === "ordering" && (
        <>
          <p
            class="ordering-instructions type-supporting"
            id={orderingInstructionsId}
          >
            Перетащи шаги за рукоятку. Клавиатура: Enter или пробел — поднять,
            ↑/↓ — переместить, Enter или пробел — положить, Esc — отменить.
          </p>
          <ol
            class="ordering-list"
            id={orderingListId}
            data-ordering-list
            aria-describedby={orderingInstructionsId}
          >
            {orderingRows.map((row, index) => (
              <li data-ordering-item data-order-key={row.answerKey}>
                <span
                  class="ordering-position type-meta type-technical"
                  data-ordering-position
                  aria-hidden="true"
                >
                  {String(index + 1).padStart(2, "0")}
                </span>
                <span data-ordering-text>{row.text}</span>
                <Button
                  class="ordering-handle"
                  variant="ghost"
                  iconOnly
                  type="button"
                  data-ordering-handle
                  aria-label={`Переместить «${row.text}». Позиция ${index + 1} из ${orderingRows.length}`}
                  aria-roledescription="рукоятка сортировки"
                >
                  <svg
                    viewBox="0 0 18 18"
                    width="18"
                    height="18"
                    data-ui-geometry-exception="drag-handle glyph geometry"
                    aria-hidden="true"
                  >
                    <circle cx="6" cy="4" r="1.25" />
                    <circle cx="12" cy="4" r="1.25" />
                    <circle cx="6" cy="9" r="1.25" />
                    <circle cx="12" cy="9" r="1.25" />
                    <circle cx="6" cy="14" r="1.25" />
                    <circle cx="12" cy="14" r="1.25" />
                  </svg>
                </Button>
              </li>
            ))}
          </ol>
          <div
            class="ordering-announcement sr-only"
            data-ordering-announcement
            role="status"
            aria-live="polite"
            aria-atomic="true"
          />
        </>
      )
    }
    {
      type === "exact" && (
        <label class="answer-field">
          <span>Ответ</span>
          <input
            type="text"
            data-exact-answer
            autocomplete="off"
            spellcheck="false"
          />
        </label>
      )
    }
    {
      type === "numeric" && (
        <label class="answer-field">
          <span>Ответ</span>
          <span class="numeric-answer">
            <input
              type="number"
              step="any"
              data-numeric-answer
              aria-label={
                numericUnit ? `Ответ, единица: ${numericUnit}` : "Ответ"
              }
            />
            {numericUnit && <span class="numeric-unit">{numericUnit}</span>}
          </span>
        </label>
      )
    }
  </fieldset>
  <div
    class="feedback type-supporting"
    data-feedback
    data-explanation={explanation}
    role="status"
    aria-live="polite"
    aria-atomic="true"
  >
  </div>
  <Button slot="actions" variant="primary" type="submit">
    Проверить ответ
  </Button>
</Card>

<script>
  import {
    Accessibility,
    DragDropManager,
    Feedback,
    KeyboardSensor,
    PointerActivationConstraints,
    PointerSensor,
    type DragEndEvent,
    type DragOverEvent,
    type DragStartEvent,
  } from "@dnd-kit/dom";
  import {
    OptimisticSortingPlugin,
    Sortable,
    isSortable,
  } from "@dnd-kit/dom/sortable";

  function getOrderingMotion() {
    return {
      duration: window.matchMedia("(prefers-reduced-motion: reduce)").matches
        ? 0
        : 180,
      easing: "cubic-bezier(0.25, 1, 0.5, 1)",
    };
  }

  function describeOrderingPickup(
    text: string,
    position: number,
    total: number,
  ) {
    return `«${text}» поднят. Позиция ${position + 1} из ${total}.`;
  }

  function describeOrderingPosition(
    text: string,
    position: number,
    total: number,
  ) {
    return `«${text}»: позиция ${position + 1} из ${total}.`;
  }

  function describeOrderingFinish(
    text: string,
    position: number,
    total: number,
    canceled: boolean,
  ) {
    return canceled
      ? `Перемещение отменено. ${describeOrderingPosition(text, position, total)}`
      : `«${text}» перемещён. Позиция ${position + 1} из ${total}.`;
  }

  function showFeedback(
    feedback: HTMLElement,
    correct: boolean,
    diagnoses: string[],
  ) {
    const result = document.createElement("strong");
    result.dataset.feedbackResult = "";
    result.textContent = correct ? "Верно! " : "Почти! Попробуй ещё раз. ";

    const responseFeedback = document.createElement("div");
    responseFeedback.className = "response-feedback";
    const diagnosesHeading = document.createElement("span");
    diagnosesHeading.textContent = "Разбор ответа:";
    const diagnosesList = document.createElement("ul");
    for (const text of diagnoses) {
      const diagnosis = document.createElement("li");
      diagnosis.textContent = text;
      diagnosesList.append(diagnosis);
    }
    responseFeedback.append(diagnosesHeading, diagnosesList);

    const governingIdea = document.createElement("span");
    governingIdea.className = "governing-idea";
    governingIdea.textContent = feedback.dataset.explanation ?? "";
    feedback.replaceChildren(result, responseFeedback, governingIdea);
    feedback.dataset.result = correct ? "correct" : "incorrect";
  }

  function initialiseKnowledgeCheck(form: HTMLFormElement) {
    if (form.dataset.ready) return;
    form.dataset.ready = "true";

    function updateOrderingPositions() {
      const rows = [
        ...form.querySelectorAll<HTMLElement>(
          "[data-ordering-item]:not([data-dnd-dragging])",
        ),
      ];
      const updateRow = (row: HTMLElement, index: number) => {
        const text =
          row.querySelector<HTMLElement>("[data-ordering-text]")?.textContent ??
          "";
        const position = row.querySelector<HTMLElement>(
          "[data-ordering-position]",
        );
        const handle = row.querySelector<HTMLButtonElement>(
          "[data-ordering-handle]",
        );
        if (position) {
          position.textContent = String(index + 1).padStart(2, "0");
        }
        if (handle) {
          handle.setAttribute(
            "aria-label",
            `Переместить «${text}». Позиция ${index + 1} из ${rows.length}`,
          );
        }
      };
      for (const [index, row] of rows.entries()) {
        updateRow(row, index);
      }
      const activeRow = form.querySelector<HTMLElement>(
        "[data-ordering-item][data-dnd-dragging]",
      );
      if (activeRow) {
        const activeIndex = rows.findIndex(
          (row) => row.dataset.orderKey === activeRow.dataset.orderKey,
        );
        if (activeIndex >= 0) {
          updateRow(activeRow, activeIndex);
        }
      }
    }

    const orderingList =
      form.querySelector<HTMLOListElement>("[data-ordering-list]");
    if (orderingList) {
      const rows = [
        ...orderingList.querySelectorAll<HTMLElement>("[data-ordering-item]"),
      ];
      const total = rows.length;
      const manager = new DragDropManager({
        sensors: (defaults) => [
          ...defaults.filter(
            (sensor) =>
              sensor !== PointerSensor && sensor !== KeyboardSensor,
          ),
          PointerSensor.configure({
            activationConstraints: (event) => [
              new PointerActivationConstraints.Distance({
                value: event.pointerType === "touch" ? 6 : 4,
              }),
            ],
          }),
        ],
        plugins: (defaults) => [
          ...defaults.filter(
            (plugin) => plugin !== Accessibility && plugin !== Feedback,
          ),
          OptimisticSortingPlugin,
          Accessibility.configure({
            id: orderingList.id,
            debounce: 120,
            screenReaderInstructions: {
              draggable:
                "Чтобы изменить порядок, нажми Enter или пробел. Используй стрелки вверх и вниз. Нажми Enter или пробел ещё раз, чтобы положить шаг, либо Escape, чтобы отменить.",
            },
            announcements: {
              dragstart({ operation: { source } }: DragStartEvent) {
                if (!source || !isSortable(source)) return;
                const text = String(source.data.text ?? source.id);
                return describeOrderingPickup(
                  text,
                  source.sortable.initialIndex,
                  total,
                );
              },
              dragover({
                operation: { source, target },
              }: DragOverEvent) {
                if (
                  !source ||
                  !target ||
                  source.id === target.id ||
                  !isSortable(target)
                ) {
                  return;
                }
                const text = String(source.data.text ?? source.id);
                return describeOrderingPosition(
                  text,
                  target.sortable.index,
                  total,
                );
              },
              dragend({
                operation: { source },
                canceled,
              }: DragEndEvent) {
                if (!source || !isSortable(source)) return;
                const text = String(source.data.text ?? source.id);
                const position = canceled
                  ? source.sortable.initialIndex
                  : source.sortable.index;
                return describeOrderingFinish(
                  text,
                  position,
                  total,
                  canceled,
                );
              },
            },
          }),
          Feedback.configure({
            dropAnimation: getOrderingMotion(),
          }),
        ],
      });

      for (const [index, row] of rows.entries()) {
        const handle =
          row.querySelector<HTMLButtonElement>("[data-ordering-handle]");
        const text =
          row.querySelector<HTMLElement>("[data-ordering-text]")?.textContent ??
          "";
        const id = row.dataset.orderKey;
        if (!handle || !id) continue;
        new Sortable(
          {
            id,
            index,
            group: orderingList.id,
            element: row,
            handle,
            data: { text },
            plugins: [OptimisticSortingPlugin],
            transition: getOrderingMotion(),
          },
          manager,
        );
      }

      const schedulePositionUpdate = () => {
        queueMicrotask(() => {
          void manager.renderer.rendering.then(updateOrderingPositions);
        });
      };
      manager.monitor.addEventListener("dragstart", () => {
        orderingList.dataset.orderingDragging = "";
      });
      manager.monitor.addEventListener("dragover", schedulePositionUpdate);
      manager.monitor.addEventListener("dragend", () => {
        schedulePositionUpdate();
        delete orderingList.dataset.orderingDragging;
      });

      const orderingAnnouncement = form.querySelector<HTMLElement>(
        "[data-ordering-announcement]",
      );
      const announceOrdering = (message: string) => {
        if (!orderingAnnouncement) return;
        orderingAnnouncement.textContent = "";
        queueMicrotask(() => {
          orderingAnnouncement.textContent = message;
        });
      };
      const getKeyboardRows = () =>
        [...orderingList.children].filter(
          (child): child is HTMLElement =>
            child instanceof HTMLElement &&
            child.matches("[data-ordering-item]") &&
            !child.hasAttribute("data-dnd-dragging") &&
            !child.hasAttribute("data-dnd-placeholder"),
        );
      const captureOrderingPositions = () => {
        const rows = getKeyboardRows();
        for (const row of rows) {
          row.getAnimations().forEach((animation) => animation.cancel());
        }
        return new Map(
          rows.map((row) => [row, row.getBoundingClientRect().top]),
        );
      };
      const animateOrderingRows = (
        previousPositions: Map<HTMLElement, number>,
      ) => {
        if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
          return;
        }
        for (const row of getKeyboardRows()) {
          const previousTop = previousPositions.get(row);
          if (previousTop === undefined) continue;
          const delta = previousTop - row.getBoundingClientRect().top;
          if (!delta) continue;
          row.animate(
            [
              { transform: `translateY(${delta}px)` },
              { transform: "translateY(0)" },
            ],
            getOrderingMotion(),
          );
        }
      };
      const moveKeyboardRowToIndex = (
        item: HTMLElement,
        desiredIndex: number,
      ) => {
        const previousPositions = captureOrderingPositions();
        const activeElement =
          item.contains(document.activeElement) &&
          document.activeElement instanceof HTMLElement
            ? document.activeElement
            : undefined;
        const remainingRows = getKeyboardRows().filter((row) => row !== item);
        if (desiredIndex >= remainingRows.length) {
          orderingList.append(item);
        } else {
          orderingList.insertBefore(item, remainingRows[desiredIndex]);
        }
        updateOrderingPositions();
        animateOrderingRows(previousPositions);
        activeElement?.focus({ preventScroll: true });
      };
      let keyboardOrdering:
        | {
            handle: HTMLButtonElement;
            initialIndex: number;
            item: HTMLElement;
          }
        | undefined;
      const finishKeyboardOrdering = (canceled: boolean) => {
        if (!keyboardOrdering) return;
        const { handle, initialIndex, item } = keyboardOrdering;
        if (canceled) {
          moveKeyboardRowToIndex(item, initialIndex);
        }
        const rows = getKeyboardRows();
        const position = rows.indexOf(item);
        const text =
          item.querySelector<HTMLElement>("[data-ordering-text]")?.textContent ??
          "";
        handle.setAttribute("aria-pressed", "false");
        handle.setAttribute("aria-grabbed", "false");
        delete item.dataset.orderingKeyboardActive;
        keyboardOrdering = undefined;
        announceOrdering(
          describeOrderingFinish(
            text,
            position,
            rows.length,
            canceled,
          ),
        );
      };

      orderingList.addEventListener("keydown", (event) => {
        const handle = (event.target as HTMLElement).closest<HTMLButtonElement>(
          "[data-ordering-handle]",
        );
        if (!handle) return;
        const item = handle.closest<HTMLElement>("[data-ordering-item]");
        if (!item) return;
        const toggle =
          event.code === "Enter" ||
          event.code === "NumpadEnter" ||
          event.code === "Space";

        if (!keyboardOrdering) {
          if (!toggle) return;
          event.preventDefault();
          event.stopPropagation();
          const rows = getKeyboardRows();
          const initialIndex = rows.indexOf(item);
          if (initialIndex < 0) return;
          keyboardOrdering = { handle, initialIndex, item };
          item.dataset.orderingKeyboardActive = "";
          handle.setAttribute("aria-pressed", "true");
          handle.setAttribute("aria-grabbed", "true");
          const text =
            item.querySelector<HTMLElement>("[data-ordering-text]")
              ?.textContent ?? "";
          announceOrdering(
            describeOrderingPickup(text, initialIndex, rows.length),
          );
          return;
        }

        if (keyboardOrdering.item !== item) return;
        if (toggle) {
          event.preventDefault();
          event.stopPropagation();
          finishKeyboardOrdering(false);
          return;
        }
        if (event.code === "Escape") {
          event.preventDefault();
          event.stopPropagation();
          finishKeyboardOrdering(true);
          return;
        }
        const direction =
          event.code === "ArrowUp"
            ? -1
            : event.code === "ArrowDown"
              ? 1
              : 0;
        if (!direction) return;
        event.preventDefault();
        event.stopPropagation();
        const rows = getKeyboardRows();
        const currentIndex = rows.indexOf(item);
        const targetIndex = Math.max(
          0,
          Math.min(rows.length - 1, currentIndex + direction),
        );
        const text =
          item.querySelector<HTMLElement>("[data-ordering-text]")?.textContent ??
          "";
        if (targetIndex === currentIndex) {
          announceOrdering(
            `«${text}» уже на позиции ${currentIndex + 1} из ${rows.length}.`,
          );
          return;
        }
        moveKeyboardRowToIndex(item, targetIndex);
        announceOrdering(
          describeOrderingPosition(text, targetIndex, rows.length),
        );
      });
    }

    form.addEventListener("submit", (event) => {
      event.preventDefault();
      const feedback = form.querySelector<HTMLElement>("[data-feedback]");
      if (!feedback) return;

      const authoredAnswer = JSON.parse(form.dataset.answer ?? "null") as
        | string
        | string[];

      if (form.dataset.type === "matching") {
        const matches = [
          ...form.querySelectorAll<HTMLSelectElement>("[data-match]"),
        ];
        if (matches.some((select) => select.value === "")) {
          feedback.textContent = "Подбери соответствие для каждой строки.";
          feedback.dataset.result = "incorrect";
          return;
        }
        const answers = Array.isArray(authoredAnswer) ? authoredAnswer : [];
        const correct = matches.every(
          (select, index) => select.value === answers[index],
        );
        const diagnoses = matches.map((select, index) => {
          const result =
            select.value === answers[index] ? "верно." : "не совпадает.";
          return `${select.dataset.matchLeft}: ${result} ${select.dataset.matchFeedback ?? ""}`;
        });
        showFeedback(feedback, correct, diagnoses);
        return;
      }

      if (form.dataset.type === "ordering") {
        const rows = [
          ...form.querySelectorAll<HTMLElement>("[data-ordering-item]"),
        ];
        const answers = Array.isArray(authoredAnswer) ? authoredAnswer : [];
        const selectedOrder = rows.map((row) => row.dataset.orderKey ?? "");
        const correct =
          selectedOrder.length === answers.length &&
          selectedOrder.every((key, index) => key === answers[index]);
        showFeedback(feedback, correct, [
          `Текущий порядок: ${rows
            .map(
              (row) =>
                row.querySelector<HTMLElement>("[data-ordering-text]")
                  ?.textContent ?? "",
            )
            .join(" → ")}`,
        ]);
        return;
      }

      if (form.dataset.type === "exact") {
        const input =
          form.querySelector<HTMLInputElement>("[data-exact-answer]");
        if (!input?.value) {
          feedback.textContent = "Введи ответ.";
          feedback.dataset.result = "incorrect";
          return;
        }
        const normalization = JSON.parse(
          form.dataset.normalization ?? "{}",
        ) as {
          trim?: boolean;
          case?: "sensitive" | "insensitive";
        };
        const normalize = (value: string) => {
          const trimmed = normalization.trim ? value.trim() : value;
          return normalization.case === "insensitive"
            ? trimmed.toLowerCase()
            : trimmed;
        };
        const answers = Array.isArray(authoredAnswer) ? authoredAnswer : [];
        const correct = answers
          .map(normalize)
          .includes(normalize(input.value));
        showFeedback(feedback, correct, [
          correct
            ? "Ответ совпадает с допустимой формой."
            : "Ответ пока не совпадает с допустимой формой.",
        ]);
        return;
      }

      if (form.dataset.type === "numeric") {
        const input =
          form.querySelector<HTMLInputElement>("[data-numeric-answer]");
        if (!input?.value || !Number.isFinite(input.valueAsNumber)) {
          feedback.textContent = "Введи числовой ответ.";
          feedback.dataset.result = "incorrect";
          return;
        }
        const answer =
          typeof authoredAnswer === "number" ? authoredAnswer : Number.NaN;
        const tolerance = Number(form.dataset.tolerance);
        const correct =
          Number.isFinite(answer) &&
          Number.isFinite(tolerance) &&
          Math.abs(input.valueAsNumber - answer) <= tolerance;
        showFeedback(feedback, correct, [
          correct
            ? "Ответ находится в допустимом диапазоне."
            : "Ответ находится вне допустимого диапазона.",
        ]);
        return;
      }

      const selected = [
        ...form.querySelectorAll<HTMLInputElement>("input:checked"),
      ];
      if (selected.length === 0) {
        feedback.textContent = "Выбери хотя бы один вариант ответа.";
        feedback.dataset.result = "incorrect";
        return;
      }

      const selectedIds = selected.map((input) => input.value);
      const correct =
        form.dataset.type === "single"
          ? selectedIds.length === 1 && selectedIds[0] === authoredAnswer
          : Array.isArray(authoredAnswer) &&
            selectedIds.length === authoredAnswer.length &&
            selectedIds.every((id) => authoredAnswer.includes(id));
      showFeedback(
        feedback,
        correct,
        selected.map((input) => input.dataset.optionFeedback ?? ""),
      );
    });
  }
  document
    .querySelectorAll<HTMLFormElement>("[data-knowledge-check]")
    .forEach(initialiseKnowledgeCheck);
</script>

