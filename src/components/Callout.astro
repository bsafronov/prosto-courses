---
type CalloutKind =
  | "key"
  | "info"
  | "warning"
  | "error"
  | "advanced"
  | "context";

interface Props {
  kind: CalloutKind;
}

const presentations = {
  key: { label: "Ключевая мысль", icon: "◆" },
  info: { label: "Информация", icon: "ⓘ" },
  warning: { label: "Предупреждение", icon: "▲" },
  error: { label: "Ошибка", icon: "×" },
  advanced: { label: "Дополнительно — необязательно", icon: "↗" },
  context: { label: "Контекст", icon: "◎" },
} satisfies Record<CalloutKind, { label: string; icon: string }>;

const { kind } = Astro.props;
const presentation = presentations[kind];
---

<aside class="callout" data-kind={kind} aria-label={presentation.label}>
  <p class="callout-label type-meta">
    <span class="callout-icon" aria-hidden="true">{presentation.icon}</span>
    <span>{presentation.label}</span>
  </p>
  <div class="callout-content"><slot /></div>
</aside>

<style>
  .callout {
    --callout-accent: var(--color-muted);
    min-width: 0;
    margin: var(--space-8) var(--space-0);
    border: 0;
    border-inline-start: var(--border-width-emphasis) solid var(--callout-accent);
    padding: var(--space-1) var(--space-0) var(--space-1) var(--space-4);
    background: transparent;
    overflow-wrap: anywhere;
  }
  .callout[data-kind="key"],
  .callout[data-kind="info"] { --callout-accent: var(--color-brand); }
  .callout[data-kind="warning"] { --callout-accent: var(--color-warning); }
  .callout[data-kind="error"] { --callout-accent: var(--color-error); }
  .callout-label {
    display: flex;
    gap: var(--space-2);
    align-items: center;
    margin: var(--space-0) var(--space-0) var(--space-2);
    color: var(--callout-accent);
    text-transform: uppercase;
  }
  .callout-icon {
    display: inline-grid;
    width: var(--space-5);
    place-items: center;
    font-size: var(--font-size-body);
  }
  .callout-content :global(> :first-child) { margin-top: 0; }
  .callout-content :global(> :last-child) { margin-bottom: 0; }
</style>
