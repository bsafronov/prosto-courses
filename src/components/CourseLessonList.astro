---
import type { LessonEntry } from "../lib/courses";
import {
  lessonDestination,
  lessonPath,
  lessonSlug,
} from "../lib/courses";
import { lessonRevisionCopy } from "../lib/ui-copy";
import ProgressStatus from "./ProgressStatus.astro";

interface Props {
  courseSlug: string;
  lessons: LessonEntry[];
  label?: string;
  currentLessonSlug?: string;
}
const {
  courseSlug,
  lessons,
  label = "Уроки курса",
  currentLessonSlug,
} = Astro.props;
---
<ol aria-label={label} class="lesson-list">
  {lessons.map((lesson, lessonIndex) => {
    const slug = lessonSlug(lesson);
    const destination = lessonDestination(slug);
    return (
      <li>
        <a
          href={lessonPath(courseSlug, slug)}
          aria-current={slug === currentLessonSlug ? "page" : undefined}
          data-lesson-link
          data-destination-id={destination.id}
          data-lesson-title={lesson.data.title}
        >
          <span class="lesson-number type-meta" aria-hidden="true">{lessonIndex + 1}</span>
          <span class="lesson-title type-body">{lesson.data.title}</span>
          <span class="lesson-state">
            <ProgressStatus destination={destination} />
            <span
              class="revisit type-meta"
              data-revision-revisit
              data-destination-id={destination.id}
              hidden
            >
              {lessonRevisionCopy.revisitLabel}
            </span>
          </span>
        </a>
      </li>
    );
  })}
</ol>

<style>
  .lesson-list {
    margin: var(--space-0);
    border-top: var(--border-subtle);
    padding: var(--space-0);
    list-style: none;
  }
  .lesson-list li { border-bottom: var(--border-subtle); }
  a {
    display: grid;
    grid-template-columns: var(--space-8) minmax(0, 1fr) auto;
    gap: var(--space-3);
    align-items: center;
    padding-block: var(--space-4);
    color: var(--color-ink);
    text-decoration: none;
  }
  a:hover .lesson-title {
    text-decoration: underline;
    text-underline-offset: var(--space-1);
  }
  .lesson-number {
    display: grid;
    width: var(--space-8);
    height: var(--space-8);
    place-items: center;
    border: var(--border-subtle);
    border-radius: var(--radius-round);
    font-family: var(--font-mono);
  }
  .lesson-title { font-weight: var(--font-weight-semibold); }
  .lesson-state {
    display: grid;
    justify-items: end;
    gap: var(--space-1);
  }
  .revisit {
    color: var(--color-warning);
    font-weight: var(--font-weight-semibold);
    text-decoration: underline;
    text-underline-offset: var(--space-1);
  }
  @media (max-width: 36rem) {
    a { grid-template-columns: var(--space-8) minmax(0, 1fr); }
    .lesson-state { grid-column: 2; justify-self: start; justify-items: start; }
  }
</style>
