---
import type { LessonEntry } from "../lib/courses";
import {
  lessonDestination,
  lessonPath,
  lessonSlug,
} from "../lib/courses";
import { lessonRevisionCopy } from "../lib/ui-copy";
import ProgressStatus from "./ProgressStatus.astro";

interface Props {
  courseSlug: string;
  lessons: LessonEntry[];
  label?: string;
  currentLessonSlug?: string;
}
const {
  courseSlug,
  lessons,
  label = "Уроки курса",
  currentLessonSlug,
} = Astro.props;
---
<ol aria-label={label} class="lesson-list">
  {lessons.map((lesson, lessonIndex) => {
    const slug = lessonSlug(lesson);
    const destination = lessonDestination(slug);
    return (
      <li>
        <a
          href={lessonPath(courseSlug, slug)}
          aria-current={slug === currentLessonSlug ? "page" : undefined}
          data-lesson-link
          data-destination-id={destination.id}
          data-lesson-title={lesson.data.title}
        >
          <span class="lesson-number" aria-hidden="true">{lessonIndex + 1}</span>
          <span class="lesson-title">{lesson.data.title}</span>
          <span class="lesson-state">
            <ProgressStatus destination={destination} />
            <span
              class="revisit"
              data-revision-revisit
              data-destination-id={destination.id}
              hidden
            >
              {lessonRevisionCopy.revisitLabel}
            </span>
          </span>
        </a>
      </li>
    );
  })}
</ol>

<style>
  .lesson-list { margin: 0; border-top: 1px solid var(--color-border); padding: 0; list-style: none; }
  .lesson-list li { border-bottom: 1px solid var(--color-border); }
  a { display: grid; grid-template-columns: 2rem 1fr auto; gap: .75rem; align-items: center; padding-block: .9rem; color: var(--color-ink); text-decoration: none; }
  a:hover .lesson-title { text-decoration: underline; text-underline-offset: .18em; }
  .lesson-number { display: grid; place-items: center; width: 2rem; height: 2rem; border: 1px solid var(--color-border); border-radius: 50%; font: 500 .72rem/1 var(--font-mono); }
  .lesson-title { font-weight: 720; }
  .lesson-state { display: grid; justify-items: end; gap: .2rem; }
  .revisit { color: var(--color-brand); font-size: .8rem; font-weight: 750; text-decoration: underline; text-underline-offset: .18em; }
  @media (max-width: 34rem) {
    a { grid-template-columns: 2rem 1fr; }
    .lesson-state { grid-column: 2; justify-self: start; justify-items: start; }
  }
</style>
