---
interface Props {
  label: string;
  summary: string;
}

const { label, summary } = Astro.props;
---

<details
  class="task-feedback"
  data-task-feedback
  role="group"
  aria-label={label}
>
  <summary>{summary}</summary>
  <div class="feedback-content">
    <slot />
  </div>
</details>

<style>
  .task-feedback {
    margin-top: 1rem;
    border-top: 1px solid var(--color-border);
    padding-top: 1rem;
  }
  summary {
    width: fit-content;
    cursor: pointer;
    color: var(--color-ink);
    font-weight: 800;
  }
  .feedback-content {
    margin-top: .85rem;
    border-left: 2px solid var(--color-muted);
    padding: .25rem 0 .25rem 1rem;
    background: transparent;
  }
</style>
