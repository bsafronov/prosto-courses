---
interface Props {
  label: string;
  summary: string;
}

const { label, summary } = Astro.props;
---

<details
  class="task-feedback"
  data-task-feedback
  role="group"
  aria-label={label}
>
  <summary>{summary}</summary>
  <div class="feedback-content">
    <slot />
  </div>
</details>

<style>
  .task-feedback {
    margin: 0;
  }
  summary {
    width: fit-content;
    cursor: pointer;
    color: var(--color-ink);
    font-weight: var(--font-weight-bold);
  }
  .feedback-content {
    margin-top: var(--space-3);
    border-left: var(--border-width-emphasis) solid var(--color-muted);
    padding: var(--space-1) var(--space-0) var(--space-1) var(--space-4);
    background: transparent;
  }
</style>
