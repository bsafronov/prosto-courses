---
import type { CoreDestinationLink } from "../lib/courses";
import ProgressStatus from "./ProgressStatus.astro";

interface Props {
  destination: CoreDestinationLink;
  align?: "start" | "end";
}

const { destination, align = "start" } = Astro.props;
---
<a
  class="sequence-destination-link type-supporting"
  href={destination.href}
  data-align={align}
>
  <span><slot /></span>
  <ProgressStatus destination={destination} />
</a>
