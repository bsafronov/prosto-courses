---
import TaskFeedback from "./TaskFeedback.astro";

interface Props {
  reasoning: string;
  alternatives: string[];
  likelyErrors: string[];
}

const { reasoning, alternatives, likelyErrors } = Astro.props;
---

<TaskFeedback
  label="Разбор решения"
  summary="Показать разбор решения"
>
  <h3 class="type-body">Ход рассуждения</h3>
  <p>{reasoning}</p>
  <h3 class="type-body">Другой подход</h3>
  <ul>{alternatives.map((alternative) => <li>{alternative}</li>)}</ul>
  <h3 class="type-body">Вероятные ошибки</h3>
  <ul>{likelyErrors.map((error) => <li>{error}</li>)}</ul>
</TaskFeedback>

<style>
  h3 {
    margin: var(--space-4) var(--space-0) var(--space-2);
    font-weight: var(--font-weight-bold);
  }
  h3:first-child { margin-top: var(--space-0); }
  p, ul { margin-top: var(--space-2); }
  ul { padding-left: var(--space-6); }
</style>
