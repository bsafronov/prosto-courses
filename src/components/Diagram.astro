---
interface Props {
  title: string;
  description: string;
  howToRead: string;
  takeaway: string;
}

const { title, description, howToRead, takeaway } = Astro.props;
---

<figure class="diagram" aria-label={title}>
  <figcaption>{title}</figcaption>
  <div
    class="diagram-visual"
    role="img"
    aria-label={description}
    aria-busy="true"
    data-mermaid-container
    tabindex="0"
  >
    <slot />
  </div>
  <div class="diagram-interpretation">
    <p><strong>Описание:</strong> {description}</p>
    <p><strong>Как читать:</strong> {howToRead}</p>
    <p><strong>Главный вывод:</strong> {takeaway}</p>
  </div>
</figure>

<script>
  import mermaid from "mermaid";

  let renderVersion = 0;

  function initialiseTheme() {
    const styles = getComputedStyle(document.documentElement);
    const color = (name: string) => styles.getPropertyValue(name).trim();
    mermaid.initialize({
      startOnLoad: false,
      securityLevel: "strict",
      theme: "base",
      themeVariables: {
        background: color("--color-canvas"),
        primaryColor: color("--color-surface"),
        primaryTextColor: color("--color-ink"),
        primaryBorderColor: color("--color-muted"),
        lineColor: color("--color-muted"),
        secondaryColor: color("--color-surface"),
        tertiaryColor: color("--color-canvas"),
        textColor: color("--color-ink"),
      },
      flowchart: { htmlLabels: false, useMaxWidth: true },
    });
  }

  async function renderDiagram(
    container: HTMLElement,
    index: number,
    force = false,
  ) {
    if (container.dataset.mermaidRendered && !force) return;
    const source =
      container.dataset.mermaidSource ??
      container.querySelector(
        "pre[data-language='mermaid'] code, code.language-mermaid",
      )?.textContent;
    if (!source?.trim()) return;
    container.dataset.mermaidSource = source;
    if (force) delete container.dataset.mermaidRendered;

    try {
      initialiseTheme();
      renderVersion += 1;
      const { svg, bindFunctions } = await mermaid.render(
        `course-diagram-${index}-${renderVersion}`,
        source,
      );
      container.innerHTML = svg;
      const rendered = container.querySelector("svg");
      rendered?.setAttribute("aria-hidden", "true");
      rendered?.removeAttribute("role");
      bindFunctions?.(container);
      container.dataset.mermaidRendered = "true";
      container.setAttribute("aria-busy", "false");
    } catch {
      container.dataset.mermaidRendered = "error";
      container.setAttribute("aria-busy", "false");
    }
  }

  document
    .querySelectorAll<HTMLElement>("[data-mermaid-container]")
    .forEach((container, index) => void renderDiagram(container, index));
  window.addEventListener("prosto-theme-change", () => {
    document
      .querySelectorAll<HTMLElement>("[data-mermaid-container]")
      .forEach((container, index) => {
        delete container.dataset.mermaidRendered;
        void renderDiagram(container, index, true);
      });
  });
</script>

<style>
  .diagram {
    min-width: 0;
    margin: 2rem 0;
    border: 0;
    background: transparent;
  }
  figcaption {
    border-bottom: 1px solid var(--color-border);
    padding: .9rem 0;
    font-weight: 800;
  }
  .diagram-visual {
    max-width: 100%;
    overflow-x: auto;
    padding: 1rem 0;
    background: transparent;
  }
  .diagram-visual :global(pre) { display: none; }
  .diagram-visual :global(svg) {
    display: block;
    width: 100% !important;
    min-width: 44rem;
    max-width: none;
    height: auto;
    margin-inline: auto;
  }
  .diagram-visual:focus-visible {
    outline: 2px solid var(--color-focus);
    outline-offset: 3px;
  }
  .diagram-interpretation {
    display: grid;
    gap: .65rem;
    border-top: 1px solid var(--color-border);
    padding: 1rem 0;
  }
  .diagram-interpretation p { margin: 0; }
  @media (prefers-reduced-motion: reduce) {
    .diagram-visual,
    .diagram-visual :global(*) {
      scroll-behavior: auto !important;
      animation-duration: 0s !important;
      animation-iteration-count: 1 !important;
      transition-duration: 0s !important;
    }
  }
</style>
