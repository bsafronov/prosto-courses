---
interface Props {
  eyebrow: string;
  eyebrowTechnical?: boolean;
  sequenceLabel: string;
  title: string;
}

const {
  eyebrow,
  eyebrowTechnical = false,
  sequenceLabel,
  title,
} = Astro.props as Props;
---

<article class="learning-page type-reading">
  <header class="learning-page__header">
    <p class:list={["eyebrow", { "type-technical": eyebrowTechnical }]}>
      {eyebrow}
    </p>
    <h1 class="learning-page__title type-page-title">{title}</h1>
    <slot name="header-details" />
  </header>
  <div class="reading-flow learning-page__body"><slot /></div>
  <slot name="after-reading" />
  <nav class="sequence-navigation" aria-label={sequenceLabel}>
    <slot name="sequence" />
  </nav>
</article>
