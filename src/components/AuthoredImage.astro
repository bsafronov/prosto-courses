---
import ExternalReference from "./ExternalReference.astro";

interface ImageMetadata {
  caption: string;
  source: {
    label: string;
    url?: string;
  };
  license: string;
  origin: "external" | "generated";
  illustrative?: true;
}

interface Props {
  src: string;
  alt: string;
  title: string;
}

const { src, alt, title } = Astro.props;
const metadata = JSON.parse(title) as ImageMetadata;
---

<figure class="authored-image" aria-label={metadata.caption}>
  <img src={src} alt={alt} loading="lazy" decoding="async" />
  <figcaption>
    <span>{metadata.caption}</span>
    <span class="provenance">
      Источник:
      {metadata.source.url
        ? <ExternalReference href={metadata.source.url}>
            {metadata.source.label}
          </ExternalReference>
        : metadata.source.label}.
      Лицензия: {metadata.license}.
    </span>
    {metadata.origin === "generated" && (
      <span class="illustrative">Иллюстративное сгенерированное изображение.</span>
    )}
  </figcaption>
</figure>

<style>
  .authored-image {
    display: grid;
    gap: .7rem;
    margin: 1.5rem 0;
  }

  img {
    max-width: 100%;
    height: auto;
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
  }

  figcaption {
    display: grid;
    gap: .25rem;
    color: var(--color-muted);
    font-size: .9rem;
  }

  .provenance,
  .illustrative {
    font-size: .82rem;
  }
</style>
