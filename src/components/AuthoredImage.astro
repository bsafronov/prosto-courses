---
import ExternalReference from "./ExternalReference.astro";

interface ImageMetadata {
  caption: string;
  source: {
    label: string;
    url?: string;
  };
  license: string;
  origin: "external" | "generated";
  illustrative?: true;
}

interface Props {
  src: string;
  alt: string;
  title: string;
}

const { src, alt, title } = Astro.props;
const metadata = JSON.parse(title) as ImageMetadata;
---

<figure class="authored-image learning-visual" aria-label={metadata.caption}>
  <img
    src={src}
    alt={alt}
    loading="lazy"
    decoding="async"
  />
  <figcaption class="learning-visual__image-caption">
    <span>{metadata.caption}</span>
    <span class="provenance learning-visual__meta">
      Источник:
      {metadata.source.url
        ? <ExternalReference href={metadata.source.url}>
            {metadata.source.label}
          </ExternalReference>
        : metadata.source.label}.
      Лицензия: {metadata.license}.
    </span>
    {metadata.origin === "generated" && (
      <span class="illustrative learning-visual__meta">
        Иллюстративное сгенерированное изображение.
      </span>
    )}
  </figcaption>
</figure>

<style>
  .authored-image {
    display: grid;
    gap: var(--space-3);
  }

  img {
    max-width: 100%;
    height: auto;
    border: var(--border-width-thin) solid var(--color-muted);
    border-radius: var(--radius);
  }
</style>
