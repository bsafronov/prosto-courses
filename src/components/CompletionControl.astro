---
import type { CoreDestinationKind } from "../lib/courses";
import {
  completionControlCopy,
  lessonRevisionCopy,
} from "../lib/ui-copy";

interface Props {
  kind: CoreDestinationKind;
}

const { kind } = Astro.props;
const copy = completionControlCopy[kind];
const headingId = `${kind}-completion-heading`;
---
<section class="completion work-area" aria-labelledby={headingId}>
  <div class="completion-copy">
    <p class="work-area__eyebrow">Локальная отметка</p>
    <h2 id={headingId} class="type-component-title">{copy.heading}</h2>
    {kind === "lesson" && (
      <p
        class="revision-notice type-supporting"
        data-revision-notice
        role="status"
        aria-live="polite"
        hidden
      >
        {lessonRevisionCopy.notice}
      </p>
    )}
    <p class="description type-supporting">{copy.description}</p>
  </div>
  <button type="button" data-completion-toggle aria-pressed="false" disabled>
    {copy.complete}
  </button>
</section>

<style>
  .completion {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: var(--space-6);
    align-items: end;
    margin-top: var(--space-12);
    padding: var(--space-5);
  }
  .completion-copy { min-width: 0; }
  .completion h2 { margin: var(--space-0); }
  .completion .description {
    margin: var(--space-3) var(--space-0) var(--space-0);
    color: var(--color-muted);
  }
  .completion .revision-notice {
    border-left: var(--border-width-emphasis) solid var(--color-brand);
    padding-left: var(--space-3);
    color: var(--color-ink);
    font-weight: var(--font-weight-semibold);
  }
  .completion button { min-width: var(--measure-completion-control); }
  .completion button[aria-pressed="true"] {
    border: var(--border-subtle);
    background: var(--color-canvas);
    color: var(--color-ink);
  }
  @media (max-width: 36rem) {
    .completion { grid-template-columns: minmax(0, 1fr); gap: var(--space-4); }
    .completion button {
      width: 100%;
      min-width: 0;
    }
  }
</style>
