---
import {
  formatFreshnessDate,
  type ContentFreshnessState,
} from "../lib/courses";
import SummaryGrid from "./SummaryGrid.astro";
import SummaryItem from "./SummaryItem.astro";

interface Props {
  state: ContentFreshnessState;
}

const { state } = Astro.props;
const verifiedAt = state.freshness.verifiedAt.toISOString().slice(0, 10);
const reviewAfter =
  state.freshness.mode === "time-sensitive"
    ? state.freshness.reviewAfter.toISOString().slice(0, 10)
    : undefined;
---
<SummaryGrid label="Актуальность материалов">
  <SummaryItem label="Проверено">
    <time datetime={verifiedAt}>
      {formatFreshnessDate(state.freshness.verifiedAt)}
    </time>
  </SummaryItem>
  {state.freshness.jurisdiction && (
    <SummaryItem label="Юрисдикция">{state.freshness.jurisdiction}</SummaryItem>
  )}
  <SummaryItem label="Состояние" tone={state.status === "stale" ? "warning" : undefined}>
    {state.status === "stable" && "Стабильные сведения"}
    {state.status === "current" && state.freshness.mode === "time-sensitive" && (
      <>
        Актуально до <time datetime={reviewAfter}>
          {formatFreshnessDate(state.freshness.reviewAfter)}
        </time>
      </>
    )}
    {state.status === "stale" && state.freshness.mode === "time-sensitive" && (
      <span class="state-message stack" role="status">
        <strong>Требуется повторная проверка</strong>
        <span class="state-message__detail type-supporting muted">
          Срок проверки истёк <time datetime={reviewAfter}>
            {formatFreshnessDate(state.freshness.reviewAfter)}
          </time>. Сверься с актуальными источниками.
        </span>
      </span>
    )}
  </SummaryItem>
</SummaryGrid>

<style>
  .state-message {
    gap: var(--space-1);
  }
  .state-message__detail {
    font-weight: var(--font-weight-regular);
  }
</style>
