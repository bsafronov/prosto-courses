---
import Button from "./Button.astro";
import Card from "./Card.astro";

interface Props {
  prompt: string;
  outcomes: string[];
  guidance?: string[];
}

function hashIdentity(value: string) {
  let hash = 2166136261;
  for (let index = 0; index < value.length; index += 1) {
    hash ^= value.charCodeAt(index);
    hash = Math.imul(hash, 16777619);
  }
  return (hash >>> 0).toString(36);
}

const { prompt, guidance = [] } = Astro.props;
const reflectionId = `reflection-${hashIdentity(prompt)}`;
const promptId = `${reflectionId}-prompt`;
const noteId = `${reflectionId}-note`;
const privacyId = `${reflectionId}-privacy`;
---

<Card
  as="section"
  class="reflection type-body"
  headingId={promptId}
  headingLevel={2}
  data-reflection
  data-reflection-id={reflectionId}
>
  <Fragment slot="eyebrow">Осмысли опыт</Fragment>
  <Fragment slot="title">{prompt}</Fragment>
  {
    guidance.length > 0 && (
      <div class="guidance type-supporting">
        <p>Если полезно, опирайся на вопросы:</p>
        <ul>
          {guidance.map((item) => (
            <li>{item}</li>
          ))}
        </ul>
      </div>
    )
  }
  <label for={noteId}>Твоя заметка</label>
  <textarea
    id={noteId}
    data-reflection-note
    aria-describedby={privacyId}
    rows="7"
  ></textarea>
  <p id={privacyId} class="privacy type-supporting">
    Текст остаётся только в этом браузере и никуда не отправляется.
  </p>
  <p
    class="status type-supporting"
    data-reflection-status
    role="status"
    aria-live="polite"
    aria-atomic="true"
  ></p>
  <div class="reflection-actions cluster" slot="actions">
    <Button variant="primary" type="button" data-reflection-copy disabled>
      Копировать
    </Button>
    <Button variant="primary" type="button" data-reflection-export disabled>
      Экспортировать
    </Button>
    <Button variant="danger" type="button" data-reflection-delete disabled>
      Удалить навсегда
    </Button>
  </div>
</Card>

<script>
  const storagePrefix = "prosto-courses:reflection:v1";

  function initialiseReflection(reflection: HTMLElement) {
    if (reflection.dataset.ready) return;
    reflection.dataset.ready = "true";

    const note =
      reflection.querySelector<HTMLTextAreaElement>("[data-reflection-note]");
    const copy = reflection.querySelector<HTMLButtonElement>(
      "[data-reflection-copy]",
    );
    const exportNote = reflection.querySelector<HTMLButtonElement>(
      "[data-reflection-export]",
    );
    const deleteNote = reflection.querySelector<HTMLButtonElement>(
      "[data-reflection-delete]",
    );
    const status = reflection.querySelector<HTMLElement>(
      "[data-reflection-status]",
    );
    const prompt = reflection.querySelector("h2")?.textContent?.trim() ?? "";
    const reflectionId = reflection.dataset.reflectionId;
    if (
      !note ||
      !copy ||
      !exportNote ||
      !deleteNote ||
      !status ||
      !reflectionId
    ) {
      return;
    }

    const storageKey = `${storagePrefix}:${window.location.pathname}:${reflectionId}`;
    const announce = (message: string) => {
      status.textContent = message;
    };
    const refreshActions = () => {
      const isEmpty = note.value.length === 0;
      copy.disabled = isEmpty;
      exportNote.disabled = isEmpty;
      deleteNote.disabled = isEmpty;
    };

    try {
      const draft = localStorage.getItem(storageKey);
      if (draft !== null) {
        note.value = draft;
        announce("Черновик восстановлен из этого браузера.");
      }
    } catch {
      announce("Браузер не разрешил восстановить локальный черновик.");
    }
    refreshActions();

    note.addEventListener("input", () => {
      refreshActions();
      try {
        if (note.value.length > 0) {
          localStorage.setItem(storageKey, note.value);
          announce("Черновик сохранён в этом браузере.");
        } else {
          localStorage.removeItem(storageKey);
          announce("Пустой черновик удалён из этого браузера.");
        }
      } catch {
        announce("Браузер не разрешил сохранить локальный черновик.");
      }
    });

    copy.addEventListener("click", async () => {
      try {
        await navigator.clipboard.writeText(note.value);
        announce("Заметка скопирована.");
      } catch {
        announce("Не удалось скопировать заметку.");
      }
    });

    exportNote.addEventListener("click", () => {
      const blob = new Blob([`${prompt}\n\n${note.value}\n`], {
        type: "text/plain;charset=utf-8",
      });
      const url = URL.createObjectURL(blob);
      const link = document.createElement("a");
      link.href = url;
      link.download = `reflection-${new Date().toISOString().slice(0, 10)}.txt`;
      link.click();
      URL.revokeObjectURL(url);
      announce("Файл с заметкой скачан.");
    });

    deleteNote.addEventListener("click", () => {
      try {
        localStorage.removeItem(storageKey);
        note.value = "";
        refreshActions();
        announce("Заметка навсегда удалена из этого браузера.");
        note.focus();
      } catch {
        announce("Браузер не разрешил удалить локальный черновик.");
      }
    });
  }

  document
    .querySelectorAll<HTMLElement>("[data-reflection]")
    .forEach(initialiseReflection);
</script>

<style>
  :global(.reflection) {
    margin-block: var(--space-8);
  }
  .guidance {
    margin-bottom: var(--space-4);
    color: var(--color-muted);
  }
  .guidance p { margin-bottom: var(--space-2); font-weight: var(--font-weight-bold); }
  .guidance ul { margin-top: var(--space-0); }
  label {
    display: block;
    margin-bottom: var(--space-2);
    font-weight: var(--font-weight-bold);
  }
  textarea {
    width: 100%;
    resize: vertical;
  }
  .privacy {
    margin: var(--space-2) var(--space-0) var(--space-4);
    border-left: var(--border-width-emphasis) solid var(--color-muted);
    padding-left: var(--space-3);
    color: var(--color-muted);
    font-family: var(--font-sans);
  }
  .status {
    min-height: var(--space-6);
    margin: var(--space-3) var(--space-0) var(--space-0);
    font-weight: var(--font-weight-bold);
  }
  @media (max-width: 36rem) {
    .reflection-actions { display: grid; width: 100%; }
    .reflection-actions :global(button) { width: 100%; }
  }
</style>
