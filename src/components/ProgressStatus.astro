---
import {
  lessonRevisionCopy,
  progressStatusAriaLabel,
  progressStatusCopy,
} from "../lib/ui-copy";
import type { CoreDestinationRef } from "../lib/courses";

interface Props {
  destination: CoreDestinationRef;
}
const { destination } = Astro.props;
const initialStatus = progressStatusCopy["not-started"];
---
<span class="status-stack">
  <span
    class="status"
    data-progress-status
    data-destination-id={destination.id}
    data-state="not-started"
    aria-label={progressStatusAriaLabel(destination.kind, initialStatus.label)}
  >
    <span data-status-icon aria-hidden="true">{initialStatus.icon}</span>
    <span data-status-label>{initialStatus.label}</span>
  </span>
  {destination.kind === "lesson" && (
    <span
      class="revision-status"
      data-revision-status
      data-destination-id={destination.id}
      aria-live="polite"
      hidden
    >
      {lessonRevisionCopy.status}
    </span>
  )}
</span>

<style>
  .status-stack { display: grid; justify-items: end; gap: .3rem; }
  .status {
    display: inline-flex;
    align-items: center;
    gap: .35rem;
    color: var(--color-muted);
    font-family: var(--font-sans);
    font-size: var(--font-size-meta);
    font-weight: var(--font-weight-medium);
    line-height: var(--line-height-meta);
    white-space: nowrap;
  }
  .status[data-state="started"],
  .status[data-state="completed"] { color: var(--color-ink); }
  .revision-status {
    border-left: 2px solid currentColor;
    padding-left: .45rem;
    color: var(--color-warning);
    font-family: var(--font-sans);
    font-size: var(--font-size-meta);
    font-weight: var(--font-weight-medium);
    line-height: var(--line-height-meta);
  }
</style>
