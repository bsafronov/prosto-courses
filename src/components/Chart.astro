---
import ExternalReference from "./ExternalReference.astro";
import LearningVisual from "./LearningVisual.astro";

interface Axis {
  label: string;
  unit: string;
}

interface ChartValue {
  x: string | number;
  y: number;
}

interface ChartSeries {
  name: string;
  values: ChartValue[];
}

interface ChartSource {
  label: string;
  url: string;
}

interface Props {
  title: string;
  description: string;
  howToRead: string;
  takeaway: string;
  xAxis: Axis;
  yAxis: Axis;
  series: ChartSeries[];
  source: ChartSource;
}

const {
  title,
  description,
  howToRead,
  takeaway,
  xAxis,
  yAxis,
  series,
  source,
} = Astro.props;

const tickNumberFormatter = new Intl.NumberFormat("ru-RU", {
  maximumFractionDigits: 2,
});
const exactValue = (value: number) => String(value);
const xValues = series[0].values.map((value) => value.x);
const allYValues = series.flatMap((item) => item.values.map((value) => value.y));
const domainMinimum = Math.min(0, ...allYValues);
const authoredDomainMaximum = Math.max(0, ...allYValues);
const domainMaximum =
  authoredDomainMaximum === domainMinimum
    ? authoredDomainMaximum + 1
    : authoredDomainMaximum;
const domainSpan = domainMaximum - domainMinimum;
// Technical exception: unitless values from `plot` through the SVG markup define
// exact data coordinates, mark shapes, and non-color pattern encoding. They do
// not participate in UI spacing or establish a local visual scale.
const plot = {
  left: 112,
  top: 80,
  right: 32,
  bottom: 120,
  width: Math.max(720, xValues.length * Math.max(150, series.length * 76)),
  height: 440,
};
const svgWidth = plot.left + plot.width + plot.right;
const svgHeight = plot.top + plot.height + plot.bottom;
const groupWidth = plot.width / xValues.length;
const barAreaWidth = groupWidth * 0.72;
const barGap = 8;
const barWidth = Math.max(
  16,
  (barAreaWidth - barGap * (series.length - 1)) / series.length,
);
const yPosition = (value: number) =>
  plot.top + ((domainMaximum - value) / domainSpan) * plot.height;
const baselineY = yPosition(0);
const ticks = Array.from({ length: 5 }, (_, index) => {
  const value = domainMinimum + (domainSpan * index) / 4;
  return { value, y: yPosition(value) };
}).reverse();
// Technical exception: series colors are data-driven inline custom properties.
// Values remain central semantic color tokens and repeat only when data exceeds them.
const chartSeriesCount = 5;
const patternKinds = ["solid", "diagonal", "dots", "crosshatch"];
const chartKey = crypto.randomUUID();
---

<LearningVisual title={title}>
  <div
    slot="visual"
    class="chart-visual learning-visual__viewport"
    role="img"
    aria-label={description}
    tabindex="0"
  >
    <svg
      width={svgWidth}
      height={svgHeight}
      viewBox={`0 0 ${svgWidth} ${svgHeight}`}
      data-ui-geometry-exception="chart coordinates and pattern geometry derive from rendered series"
      data-ui-token-expression="series colors are selected from central data-series tokens"
      aria-hidden="true"
    >
      <defs>
        {series.map((_, index) => {
          const color = `var(--color-data-series-${(index % chartSeriesCount) + 1})`;
          const pattern = patternKinds[index % patternKinds.length];
          return (
            <pattern
              id={`chart-${chartKey}-series-${index}`}
              width="10"
              height="10"
              patternUnits="userSpaceOnUse"
            >
              <rect width="10" height="10" fill={color} />
              {pattern === "diagonal" && (
                <path
                  d="M-2 2 L2 -2 M0 10 L10 0 M8 12 L12 8"
                  stroke="var(--color-canvas)"
                  stroke-width="var(--border-width-emphasis)"
                  opacity="var(--opacity-data-pattern)"
                />
              )}
              {pattern === "dots" && (
                <circle
                  cx="5"
                  cy="5"
                  r="2"
                  fill="var(--color-canvas)"
                  opacity="var(--opacity-data-pattern)"
                />
              )}
              {pattern === "crosshatch" && (
                <path
                  d="M0 0 L10 10 M10 0 L0 10"
                  stroke="var(--color-canvas)"
                  stroke-width="var(--border-width-thin)"
                  opacity="var(--opacity-data-pattern)"
                />
              )}
            </pattern>
          );
        })}
      </defs>

      {ticks.map((tick) => (
        <g>
          <line
            x1={plot.left}
            y1={tick.y}
            x2={plot.left + plot.width}
            y2={tick.y}
            class="chart-grid-line"
          />
          <text
            x={plot.left - 12}
            y={tick.y + 5}
            text-anchor="end"
            class="chart-tick-label"
          >
            {tickNumberFormatter.format(tick.value)}
          </text>
        </g>
      ))}

      <line
        x1={plot.left}
        y1={baselineY}
        x2={plot.left + plot.width}
        y2={baselineY}
        class="chart-axis-line"
      />

      {xValues.map((xValue, valueIndex) => {
        const groupStart =
          plot.left + valueIndex * groupWidth + (groupWidth - barAreaWidth) / 2;
        return (
          <g>
            {series.map((item, seriesIndex) => {
              const value = item.values[valueIndex].y;
              const valueY = yPosition(value);
              const barY = Math.min(valueY, baselineY);
              const height = Math.max(1, Math.abs(baselineY - valueY));
              const x = groupStart + seriesIndex * (barWidth + barGap);
              return (
                <g>
                  <rect
                    x={x}
                    y={barY}
                    width={barWidth}
                    height={height}
                    rx="3"
                    fill={`url(#chart-${chartKey}-series-${seriesIndex})`}
                  />
                  <text
                    x={x + barWidth / 2}
                    y={value >= 0 ? barY - 7 : barY + height + 16}
                    text-anchor="middle"
                    class="chart-value-label"
                  >
                    {seriesIndex + 1}: {exactValue(value)}
                  </text>
                </g>
              );
            })}
            <text
              x={plot.left + valueIndex * groupWidth + groupWidth / 2}
              y={plot.top + plot.height + 28}
              text-anchor="middle"
              class="chart-category-label"
            >
              {xValue}
            </text>
          </g>
        );
      })}

      <text
        x={plot.left + plot.width / 2}
        y={svgHeight - 12}
        text-anchor="middle"
        class="chart-axis-label"
      >
        {xAxis.label} ({xAxis.unit})
      </text>
      <text
        transform={`translate(32 ${plot.top + plot.height / 2}) rotate(-90)`}
        text-anchor="middle"
        class="chart-axis-label"
      >
        {yAxis.label} ({yAxis.unit})
      </text>
    </svg>
  </div>

  <div slot="details" class="chart-details stack">
    <dl class="chart-axes">
      <div>
        <dt>Горизонтальная ось</dt>
        <dd>{xAxis.label} ({xAxis.unit})</dd>
      </div>
      <div>
        <dt>Вертикальная ось</dt>
        <dd>{yAxis.label} ({yAxis.unit})</dd>
      </div>
    </dl>

    <ul class="chart-legend" aria-label="Легенда графика">
      {series.map((item, index) => (
        <li>
          <span
            class={`chart-swatch chart-swatch-${patternKinds[index % patternKinds.length]} chart-series-${(index % chartSeriesCount) + 1}`}
            aria-hidden="true"
          ></span>
          <span class="chart-series-key" aria-hidden="true">{index + 1}</span>
          <span>{item.name}</span>
        </li>
      ))}
    </ul>

    <div
      class="chart-table-scroll"
      role="region"
      aria-label={`Таблица данных: ${title}`}
      tabindex="0"
    >
      <table>
        <caption>Данные: {title}</caption>
        <thead>
          <tr>
            <th scope="col">{xAxis.label} ({xAxis.unit})</th>
            {series.map((item) => (
              <th scope="col">{item.name} ({yAxis.unit})</th>
            ))}
          </tr>
        </thead>
        <tbody>
          {xValues.map((xValue, valueIndex) => (
            <tr>
              <th scope="row">{xValue}</th>
              {series.map((item) => (
                <td>{exactValue(item.values[valueIndex].y)}</td>
              ))}
            </tr>
          ))}
        </tbody>
      </table>
    </div>

    <div class="chart-interpretation learning-visual__interpretation">
      <p><strong>Описание:</strong> {description}</p>
      <p><strong>Как читать:</strong> {howToRead}</p>
      <p><strong>Главный вывод:</strong> {takeaway}</p>
      <p>
        <strong>Источник:</strong>
        {" "}
        <ExternalReference href={source.url}>{source.label}</ExternalReference>
      </p>
    </div>
  </div>
</LearningVisual>

<style>
  .chart-visual svg { display: block; max-width: none; }
  /* Technical exception: stroke widths and hatch dimensions encode SVG/data-mark
     geometry. UI color, typography, spacing, borders, and focus use system tokens. */
  .chart-grid-line {
    stroke: var(--color-border);
    stroke-width: var(--border-width-thin);
  }
  .chart-axis-line {
    stroke: var(--color-ink);
    stroke-width: var(--border-width-emphasis);
  }
  .chart-tick-label,
  .chart-category-label,
  .chart-value-label,
  .chart-axis-label {
    fill: var(--color-ink);
    font-family: var(--font-sans);
  }
  .chart-tick-label,
  .chart-category-label {
    font-size: var(--font-size-meta);
    font-weight: var(--font-weight-medium);
  }
  .chart-value-label {
    font-size: var(--font-size-meta);
    font-weight: var(--font-weight-semibold);
  }
  .chart-axis-label {
    font-size: var(--font-size-supporting);
    font-weight: var(--font-weight-semibold);
  }
  .chart-details {
    border-top: var(--border-subtle);
    padding-block: var(--space-4);
  }
  .chart-axes {
    display: grid;
    grid-template-columns: repeat(
      auto-fit,
      minmax(min(100%, var(--measure-compact)), 1fr)
    );
    gap: var(--space-3);
    margin: var(--space-0);
  }
  .chart-axes div {
    border-bottom: var(--border-subtle);
    padding-block: var(--space-3);
  }
  .chart-axes dt {
    color: var(--color-muted);
    font-size: var(--font-size-meta);
    font-weight: var(--font-weight-medium);
    letter-spacing: var(--tracking-meta);
    line-height: var(--line-height-meta);
  }
  .chart-axes dd {
    margin: var(--space-1) var(--space-0) var(--space-0);
    font-size: var(--font-size-supporting);
    font-weight: var(--font-weight-regular);
    line-height: var(--line-height-supporting);
  }
  .chart-legend {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3) var(--space-4);
    margin: var(--space-0);
    padding: var(--space-0);
    font-size: var(--font-size-supporting);
    font-weight: var(--font-weight-regular);
    line-height: var(--line-height-supporting);
    list-style: none;
  }
  .chart-legend li {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
  }
  .chart-series-key {
    display: inline-grid;
    min-width: var(--target-min-size);
    min-height: var(--target-min-size);
    place-items: center;
    border: var(--border-width-thin) solid var(--color-ink);
    border-radius: var(--radius-round);
    font-size: var(--font-size-meta);
    font-weight: var(--font-weight-semibold);
    line-height: var(--line-height-meta);
  }
  .chart-swatch {
    width: var(--target-min-size);
    height: var(--space-4);
    border: var(--border-width-thin) solid var(--color-ink);
    border-radius: var(--radius);
    background-color: var(--chart-color);
  }
  .chart-series-1 { --chart-color: var(--color-data-series-1); }
  .chart-series-2 { --chart-color: var(--color-data-series-2); }
  .chart-series-3 { --chart-color: var(--color-data-series-3); }
  .chart-series-4 { --chart-color: var(--color-data-series-4); }
  .chart-series-5 { --chart-color: var(--color-data-series-5); }
  .chart-swatch-diagonal {
    background-image: repeating-linear-gradient(
      var(--pattern-angle-diagonal),
      transparent 0 var(--space-1),
      var(--color-canvas) var(--space-1) var(--space-2)
    );
  }
  .chart-swatch-dots {
    background-image:
      radial-gradient(
        var(--color-canvas) var(--border-width-thin),
        transparent var(--border-width-thin)
      );
    background-size: var(--space-2) var(--space-2);
  }
  .chart-swatch-crosshatch {
    background-image:
      linear-gradient(var(--pattern-angle-crosshatch), transparent 44%, var(--color-canvas) 45% 55%, transparent 56%),
      linear-gradient(calc(-1 * var(--pattern-angle-crosshatch)), transparent 44%, var(--color-canvas) 45% 55%, transparent 56%);
    background-size: var(--space-2) var(--space-2);
  }
  .chart-table-scroll {
    max-width: 100%;
    overflow-x: auto;
    overscroll-behavior-inline: contain;
  }
  table {
    width: 100%;
    min-width: var(--measure-offline);
    border-collapse: collapse;
    font-size: var(--font-size-body);
    line-height: var(--line-height-body);
  }
  caption {
    margin-bottom: var(--space-2);
    color: var(--color-muted);
    font-size: var(--font-size-supporting);
    font-weight: var(--font-weight-semibold);
    line-height: var(--line-height-supporting);
    text-align: left;
  }
  th, td {
    border: var(--border-subtle);
    padding: var(--space-2) var(--space-3);
    text-align: right;
  }
  thead th, tbody th {
    background: var(--color-surface);
    color: var(--color-ink);
    font-weight: var(--font-weight-semibold);
    text-align: left;
  }
</style>
