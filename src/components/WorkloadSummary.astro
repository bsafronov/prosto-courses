---
import SummaryGrid from "./SummaryGrid.astro";
import SummaryItem from "./SummaryItem.astro";

interface Props {
  label: string;
  items: Array<{ label: string; value: string }>;
}

const { label, items } = Astro.props;
---

<SummaryGrid label={label}>
  {items.map((item) => (
    <SummaryItem label={item.label}>{item.value}</SummaryItem>
  ))}
</SummaryGrid>
