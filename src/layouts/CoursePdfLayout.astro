---
import "@fontsource/onest/400.css";
import "@fontsource/onest/500.css";
import "@fontsource/onest/600.css";
import "@fontsource/onest/700.css";
import "@fontsource/ibm-plex-mono/400.css";
import "@fontsource/ibm-plex-mono/500.css";
import "../styles/global.css";

interface Props {
  filename: string;
  title: string;
}

const { filename, title } = Astro.props as Props;
---

<!doctype html>
<html lang="ru" data-theme="light" data-theme-mode="light">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="course-pdf-filename" content={filename} />
    <title>{title}</title>
  </head>
  <body>
    <slot />
  </body>
</html>

<style is:global>
  @media print {
    @page {
      size: A4 portrait;
    }

    html,
    body {
      background: var(--color-print-canvas);
      color: var(--color-print-ink);
    }

    body {
      print-color-adjust: exact;
    }

    .course-pdf {
      --color-canvas: var(--color-print-canvas);
      --color-surface: var(--color-print-surface);
      --color-ink: var(--color-print-ink);
      --color-muted: var(--color-print-muted);
      --color-border: var(--color-print-border);
      --color-brand: var(--color-print-brand);
      --color-brand-dark: var(--color-print-ink);
      --color-warning: var(--color-print-ink);
      --color-error: var(--color-print-ink);
      --color-completed: var(--color-print-surface);
      --color-completed-ink: var(--color-print-ink);
      --border-subtle: var(--border-print-subtle);
      --color-data-series-1: var(--color-print-data-series-1);
      --color-data-series-2: var(--color-print-data-series-2);
      --color-data-series-3: var(--color-print-data-series-3);
      --color-data-series-4: var(--color-print-data-series-4);
      --color-data-series-5: var(--color-print-data-series-5);

      font-family: var(--font-sans);
      background: var(--color-canvas);
      color: var(--color-ink);
    }

    .course-pdf__cover {
      break-after: page;
      border-block-start: var(--border-width-emphasis) solid var(--color-muted);
      padding-block: var(--space-page-start) var(--space-page-end);
    }

    .course-pdf__toc,
    .course-pdf__overview,
    .course-pdf__module,
    .course-pdf__lesson,
    .course-pdf__checkpoint,
    .course-pdf__capstone,
    .course-pdf__knowledge-check-appendix,
    .course-pdf__practice-task-appendix,
    .course-pdf__sources {
      break-before: page;
    }

    .course-pdf__release-identity {
      display: grid;
      gap: var(--space-5);
      margin-block-start: var(--space-8);
    }

    .course-pdf__release-identity dl,
    .course-pdf__release-identity dl div {
      display: grid;
      gap: var(--space-1);
      margin: 0;
    }

    .course-pdf__release-identity dt {
      color: var(--color-muted);
      font-size: var(--font-size-meta);
      font-weight: var(--font-weight-semibold);
      text-transform: uppercase;
    }

    .course-pdf__release-identity dd {
      margin: 0;
    }

    .course-pdf__toc ol,
    .course-pdf__sources ol {
      display: grid;
      gap: var(--space-2);
    }

    .course-pdf__toc ol ol {
      margin-block: var(--space-2) var(--space-3);
    }

    .course-pdf__source-entry {
      break-inside: avoid;
    }

    .course-pdf__source-label {
      display: block;
      font-weight: var(--font-weight-semibold);
    }

    .course-pdf__section-label {
      color: var(--color-muted);
      text-transform: uppercase;
    }

    .course-pdf__summary {
      color: var(--color-muted);
    }

    .course-pdf-activity {
      margin-block: var(--space-10);
      border: var(--border-subtle);
      padding: var(--space-card);
    }

    .course-pdf .button-control,
    .course-pdf dialog,
    .course-pdf textarea,
    .course-pdf [role="status"] {
      display: none;
    }

    .course-pdf__release-identity [role="status"] {
      display: grid;
    }

    .course-pdf details > * {
      display: block;
    }

    .course-pdf .learning-visual__viewport,
    .course-pdf pre,
    .course-pdf table {
      overflow: visible;
    }

    .course-pdf :where(h1, h2, h3, h4, h5, h6) {
      break-after: avoid-page;
    }

    .course-pdf :where(p, li) {
      orphans: 3;
      widows: 3;
    }

    .course-pdf :where(
      blockquote,
      figure,
      pre,
      table,
      .callout,
      .course-pdf-activity
    ) {
      break-inside: avoid-page;
    }

    .course-pdf pre,
    .course-pdf pre code {
      background: var(--color-surface) !important;
      color: var(--color-ink) !important;
      white-space: pre-wrap;
      overflow-wrap: anywhere;
      word-break: normal;
    }

    .course-pdf pre code span {
      background: var(--color-surface) !important;
      color: var(--color-ink) !important;
    }

    .course-pdf :where(.learning-visual, .learning-visual__viewport) {
      max-width: 100%;
    }

    .course-pdf .learning-visual {
      margin-inline: var(--space-0);
    }

    .course-pdf .learning-visual .chart-visual :where(
      .chart-tick-label,
      .chart-category-label,
      .chart-value-label
    ) {
      font-size: var(--font-size-supporting);
    }

    .course-pdf .learning-visual__viewport > svg {
      width: auto !important;
      height: auto;
      min-width: 0 !important;
      max-width: 100% !important;
    }

    .course-pdf .chart-table-scroll table {
      min-width: 0;
      table-layout: fixed;
    }

    .course-pdf table thead {
      display: table-header-group;
    }

    .course-pdf table tr {
      break-inside: avoid-page;
    }

    .course-pdf a {
      color: var(--color-ink);
      overflow-wrap: anywhere;
    }

    .course-pdf img,
    .course-pdf svg {
      max-width: 100%;
    }
  }
</style>
