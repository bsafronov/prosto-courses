---
import PwaControl from "../components/PwaControl.astro";
import ThemeControl from "../components/ThemeControl.astro";
import { sitePath } from "../lib/courses";
import { pwaInfo } from "virtual:pwa-info";
import "@fontsource/onest/400.css";
import "@fontsource/onest/500.css";
import "@fontsource/onest/600.css";
import "@fontsource/onest/700.css";
import "@fontsource/ibm-plex-mono/400.css";
import "@fontsource/ibm-plex-mono/500.css";
import "../styles/global.css";
import tokenSource from "../styles/tokens.css?raw";

interface Props {
  title: string;
  description?: string;
  mobileTitle?: string;
  courseRouteControl?: boolean;
}
const {
  title,
  description = "Короткие практические курсы.",
  mobileTitle,
  courseRouteControl = false,
} = Astro.props;
const canvasColors = [
  ...tokenSource.matchAll(/--color-canvas\s*:\s*(#[\da-f]+)\s*;/gi),
].map((match) => match[1]);
if (canvasColors.length !== 2) {
  throw new Error("Expected light and dark --color-canvas tokens");
}
const themeColors = { light: canvasColors[0], dark: canvasColors[1] };
---
<!doctype html>
<html lang="ru">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="" />
    <link
      rel="icon"
      href={sitePath("favicon.svg")}
      type="image/svg+xml"
      sizes="any"
    />
    <link rel="icon" href={sitePath("favicon.ico")} sizes="48x48" />
    <link
      rel="apple-touch-icon"
      href={sitePath("apple-touch-icon-180x180.png")}
      sizes="180x180"
    />
    {pwaInfo && <Fragment set:html={pwaInfo.webManifest.linkTag} />}
    <title>{title}</title>
    <script is:inline define:vars={{ themeColors }}>
      (() => {
        let mode = "system";
        try {
          const stored = localStorage.getItem("prosto-courses:theme");
          if (stored === "light" || stored === "dark") mode = stored;
        } catch {}
        const theme = mode === "system"
          ? matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light"
          : mode;
        document.documentElement.dataset.themeMode = mode;
        document.documentElement.dataset.theme = theme;
        const syncThemeColor = () => {
          const color = themeColors[document.documentElement.dataset.theme];
          if (color) {
            document.querySelector('meta[name="theme-color"]')
              ?.setAttribute("content", color);
          }
        };
        syncThemeColor();
        window.addEventListener("prosto-theme-change", syncThemeColor);
      })();
    </script>
  </head>
  <body>
    <header class:list={["site-header", { "learning-header": courseRouteControl }]}>
      <div class="container header-inner">
        <div class="header-leading">
          {courseRouteControl && (
            <button
              type="button"
              class="course-route-toggle button-secondary button-icon"
              data-course-route-toggle
              aria-label="Открыть маршрут курса"
              aria-controls="course-route-panel"
              aria-expanded="false"
            >☰</button>
          )}
          <a class="brand" href={sitePath()}>Prosto.Courses</a>
          {mobileTitle && <span class="mobile-title">{mobileTitle}</span>}
        </div>
        <div class="header-actions">
          <a class="link-control" href={sitePath()}>Каталог</a>
          <ThemeControl />
          <PwaControl />
        </div>
      </div>
    </header>
    <main><slot /></main>
    <footer class="site-footer"><div class="container">Учись в своём темпе.</div></footer>
    <script src="../scripts/external-references.ts"></script>
  </body>
</html>

<style>
  .site-header {
    position: sticky;
    z-index: var(--layer-header);
    top: 0;
    border-bottom: var(--border-subtle);
    background: color-mix(
      in srgb,
      var(--color-canvas) var(--shell-header-canvas-share),
      transparent
    );
    backdrop-filter: blur(var(--shell-header-backdrop-blur));
  }
  .header-inner {
    min-height: calc(
      var(--shell-header-min-height) - var(--border-width-thin)
    );
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
  }
  .header-actions {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: var(--space-4);
    font-size: var(--font-size-supporting);
    line-height: var(--line-height-supporting);
  }
  .header-leading {
    min-width: 0;
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }
  .course-route-toggle {
    display: none;
    width: var(--control-min-height);
    min-height: var(--control-min-height);
  }
  .mobile-title { display: none; }
  .header-actions > a { color: var(--color-ink); text-decoration: none; }
  .brand {
    color: var(--color-ink);
    font-size: var(--font-size-body);
    font-weight: var(--font-weight-semibold);
    text-decoration: none;
    letter-spacing: var(--tracking-title);
  }
  .site-footer {
    margin-top: var(--shell-footer-space-before);
    border-top: var(--border-subtle);
    padding: var(--space-8) 0;
    color: var(--color-muted);
    font-size: var(--font-size-supporting);
    line-height: var(--line-height-supporting);
  }
  @media (max-width: 42rem) {
    .header-inner {
      display: grid;
      width: calc(100% - var(--space-6));
      grid-template-columns: minmax(0, 1fr) auto;
      gap: var(--space-2);
      padding-block: var(--space-2);
    }
    .header-actions { display: contents; }
    .header-actions > a { display: none; }
    :global(.theme-control) { grid-column: 2; grid-row: 1; }
    :global(.pwa-control) {
      width: 100%;
      grid-column: 1 / -1;
      grid-row: 2;
    }
    .learning-header .header-inner {
      display: flex;
      padding-block: 0;
    }
    .learning-header .header-actions { display: flex; }
  }
  @media (max-width: 52rem) {
    .course-route-toggle { display: inline-grid; place-items: center; }
    .course-route-toggle + .brand { display: none; }
    .mobile-title {
      display: block;
      max-width: min(
        50%,
        var(--measure-mobile-title)
      );
      overflow: hidden;
      color: var(--color-ink);
      font-size: var(--font-size-supporting);
      font-weight: var(--font-weight-medium);
      line-height: var(--line-height-supporting);
      text-overflow: ellipsis;
      white-space: nowrap;
    }
    .learning-header .header-actions > a,
    .learning-header :global(.pwa-control) { display: none !important; }
  }
</style>
