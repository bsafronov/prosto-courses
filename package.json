{
  "name": "prosto-courses",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.9.0",
  "scripts": {
    "dev": "ASTRO_TELEMETRY_DISABLED=1 astro dev",
    "generate:pwa-icons": "pwa-assets-generator",
    "validate": "node scripts/validate-content.mjs && node scripts/validate-ui-contract.mjs && ASTRO_TELEMETRY_DISABLED=1 astro check",
    "build": "pnpm validate && ASTRO_TELEMETRY_DISABLED=1 astro build",
    "preview": "ASTRO_TELEMETRY_DISABLED=1 astro preview",
    "test": "pnpm test:contract && pnpm test:browser",
    "test:contract": "node --test tests/*.test.mjs",
    "test:browser": "playwright test",
    "test:browser:cross-browser": "PLAYWRIGHT_CROSS_BROWSER=1 playwright test tests/browser/canonical-course-qa.spec.ts --project=firefox --project=webkit",
    "typecheck": "ASTRO_TELEMETRY_DISABLED=1 astro check"
  },
  "dependencies": {
    "@astrojs/mdx": "7.0.3",
    "@dnd-kit/dom": "0.5.0",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@fontsource/onest": "5.3.0",
    "@lucide/astro": "1.28.0",
    "astro": "7.1.3",
    "gray-matter": "4.0.3",
    "mermaid": "11.16.0"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.9",
    "@astrojs/markdown-remark": "7.2.1",
    "@playwright/test": "1.61.1",
    "@types/node": "26.1.1",
    "@vite-pwa/assets-generator": "1.0.2",
    "@vite-pwa/astro": "1.2.0",
    "jsdom": "26.1.0",
    "typescript": "6.0.3",
    "vite-plugin-pwa": "1.3.0",
    "workbox-window": "7.4.1"
  }
}
